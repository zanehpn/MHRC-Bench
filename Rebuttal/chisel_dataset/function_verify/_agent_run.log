+    test(new ReductionMux(W = 8, NUM_IN = 4, SEL_IN = 4)) { dut =>
+      dut.io.i_data(0).poke(11.U)
+      dut.io.i_data(1).poke(22.U)
+      dut.io.i_data(2).poke(33.U)
+      dut.io.i_data(3).poke(44.U)
