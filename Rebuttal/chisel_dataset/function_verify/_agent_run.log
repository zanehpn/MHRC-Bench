+import org.scalatest.flatspec.AnyFlatSpec
+
+class ReductionMuxTargetSpec extends AnyFlatSpec with ChiselScalatestTester {
+  "ReductionMux" should "zero the left output when the left select is out of range" in {
+    test(new ReductionMux(W = 8, NUM_IN = 4, SEL_IN = 4)) { dut =>
+      dut.io.i_data(0).poke(11.U)
+      dut.io.i_data(1).poke(22.U)
+      dut.io.i_data(2).poke(33.U)
+      dut.io.i_data(3).poke(44.U)
+
+      dut.io.i_sel.poke("b0011".U)
+      dut.io.o_data(0).expect(0.U)
+      dut.io.o_data(1).expect(33.U)
+
+      dut.io.i_sel.poke("b0001".U)
+      dut.io.o_data(0).expect(22.U)
+    }
+  }
+}
