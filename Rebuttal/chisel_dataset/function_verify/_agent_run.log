@@ -0,0 +1,37 @@
+package controller
+
+import chisel3._
+import chiseltest._
+import org.scalatest.flatspec.AnyFlatSpec
+
+class ControllerTargetSpec extends AnyFlatSpec with ChiselScalatestTester {
+  "Controller" should "route the selected write request onto the memory channel" in {
+    test(new Controller(AddrBits = 8, DataBits = 16, NumConsumers = 2, NumChannels = 1, WriteEnable = true)) { dut =>
+      dut.io.consumer_read_addr_receiver.foreach { in =>
+        in.valid.poke(false.B)
+        in.bits.poke(0.U)
+      }
+      dut.io.consumer_write_receiver.get.foreach { in =>
+        in.valid.poke(false.B)
+        in.bits.address.poke(0.U)
+        in.bits.data.poke(0.U)
+      }
+      dut.io.mem_read_sender(0).ready.poke(false.B)
+      dut.io.mem_read_data(0).poke(0.U)
+      dut.io.mem_write_sender.get(0).ready.poke(false.B)
+
+      dut.io.consumer_write_receiver.get(1).valid.poke(true.B)
+      dut.io.consumer_write_receiver.get(1).bits.address.poke(9.U)
+      dut.io.consumer_write_receiver.get(1).bits.data.poke("h55".U)
+      dut.clock.step()
+
+      dut.io.mem_write_sender.get(0).valid.expect(true.B)
+      dut.io.mem_write_sender.get(0).bits.address.expect(9.U)
+      dut.io.mem_write_sender.get(0).bits.data.expect("h55".U)
+
+      dut.io.mem_write_sender.get(0).ready.poke(true.B)
+      dut.clock.step()
+      dut.io.consumer_write_receiver.get(1).ready.expect(true.B)
+    }
+  }
+}
