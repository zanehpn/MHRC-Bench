diff --git a//ssd1/zqy/Multi-hdl-language-repo/chisel_dataset/function_verify/DecoupledGCD/DecoupledGCDTargetSpec.scala b//ssd1/zqy/Multi-hdl-language-repo/chisel_dataset/function_verify/DecoupledGCD/DecoupledGCDTargetSpec.scala
