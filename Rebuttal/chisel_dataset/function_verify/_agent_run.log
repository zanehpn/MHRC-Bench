@@ -0,0 +1,23 @@
+package loywong.examples
+
+import chisel3._
+import chiseltest._
+import org.scalatest.flatspec.AnyFlatSpec
+
+class CounterTargetSpec extends AnyFlatSpec with ChiselScalatestTester {
+  "counter_max_example" should "reset to zero when CounterMax wraps" in {
+    test(new counter_max_example(4)) { dut =>
+      dut.io.max.poke(2.U)
+      dut.io.en.poke(true.B)
+
+      dut.io.out.expect(0.U)
+      dut.clock.step()
+      dut.io.out.expect(1.U)
+      dut.clock.step()
+      dut.io.out.expect(2.U)
+      dut.io.co.expect(true.B)
+      dut.clock.step()
+      dut.io.out.expect(0.U)
+    }
+  }
+}
