+
+import chisel3._
+import chiseltest._
+import org.scalatest.flatspec.AnyFlatSpec
+
+class AccumulatorTargetSpec extends AnyFlatSpec with ChiselScalatestTester {
+  "Accumulator" should "only update on enable and wrap with nextWrap" in {
+    test(new Accumulator(10)) { dut =>
+      dut.io.en.poke(false.B)
+      dut.io.step.poke(3.S)
+      dut.clock.step()
+      dut.io.accu.expect(0.U)
+
+      dut.io.en.poke(true.B)
+      dut.io.step.poke(3.S)
+      dut.clock.step()
+      dut.io.accu.expect(3.U)
+
+      dut.io.step.poke(8.S)
+      dut.io.wrapUp.expect(true.B)
+      dut.clock.step()
+      dut.io.accu.expect(1.U)
+    }
+  }
+}
