import json, os, difflib
base='/ssd1/zqy/Multi-hdl-language-repo'
manifest=f'{base}/hls_dataset/function_verify/design_function_verify_candidates_50.jsonl'
for idx,line in enumerate(open(manifest),1):
    row=json.loads(line)
    local=os.path.join(base,'hls_dataset/function_verify',row['local_file'])
    orig=os.path.join(base,'hls_dataset/function_verify',row['local_original_file'])
    a=open(orig,errors='ignore').read().splitlines()
    b=open(local,errors='ignore').read().splitlines()
    diff=list(difflib.unified_diff(a,b,n=1))
    print(f'## {idx:02d} {row[\"local_folder\"]}')
    if not diff:
        print('NO_DIFF')
        continue
    out=[]
    count=0
    for l in diff:
        if l.startswith('@@') or l.startswith('+') or l.startswith('-'):
            out.append(l)
            count += 1
            if count >= 12:
                break
    print('\\n'.join(out))
