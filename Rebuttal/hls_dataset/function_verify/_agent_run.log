+                y_t_float = (x - xMax) / 2.0f + 242.0f;
+            } else if (x > xMin) {
+                y_t_float = (x - xMin) / xMax_minus_xMin * 230.0f + 13.0f;
+            } else {
+                y_t_float = x / float(xMin) * 13.0f;
