+        row["local_testbench"] = f"{folder}/BLOCKER.md"
+        row["testbench_kind"] = "blocked"
+    manifest_rows.append(row)
+
+MANIFEST.write_text("\n".join(json.dumps(row) for row in manifest_rows) + "\n")

