+from __future__ import annotations
+
+import json
+import os
+import shutil
+import textwrap
+from pathlib import Path
+
+
+ROOT = Path("/ssd1/zqy/Multi-hdl-language-repo")
+FV = ROOT / "hls_dataset" / "function_verify"
+HLS = ROOT / "hls"
+MANIFEST = FV / "design_function_verify_candidates_50.jsonl"
+
+
+def write(path: Path, content: str) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(content.rstrip() + "\n")
+
+
+support_files = {
+    FV / "_support" / "hls_stream.h": r"""
+        #pragma once
+
+        #include <cassert>
+        #include <queue>
+        #include <string>
+
+        namespace hls {
+        template <typename T, int DEPTH = 0>
+        class stream {
+        public:
+            stream() = default;
+            explicit stream(const char *) {}
+            explicit stream(const std::string &) {}
+
+            void write(const T &value) { q_.push(value); }
+
+            T read() {
+                assert(!q_.empty());
+                T value = q_.front();
+                q_.pop();
+                return value;
+            }
+
+            bool empty() const { return q_.empty(); }
+            bool full() const { return false; }
+            std::size_t size() const { return q_.size(); }
+
+        private:
+            std::queue<T> q_;
+        };
+
+        template <typename T, int DEPTH>
+        stream<T, DEPTH> &operator<<(stream<T, DEPTH> &s, const T &value) {
+            s.write(value);
+            return s;
+        }
+
+        template <typename T, int DEPTH>
+        stream<T, DEPTH> &operator>>(stream<T, DEPTH> &s, T &value) {
+            value = s.read();
+            return s;
+        }
+        }  // namespace hls
+    """,
+    FV / "_support" / "hls_math.h": r"""
