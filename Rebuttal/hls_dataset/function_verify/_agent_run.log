treturn reduction_unsigned(xy, p, idx_p);\n}\n#endif //FUNCTION_SIGNED_OR_NOT\n\n\n//signed version\ninline ap_int<P_WIDTH> reduction(ap_int<XY_WIDTH> xy, ap_uint<P_WIDTH> p, unsigned int idx_p){\n#pragma HLS PIPELINE\n//#pragma HLS ARRAY_PARTITION variable=MODULAR_TABLE dim=0\n\tap_int<XY_WIDTH+1> xy_shift_signed65 = ap_int<XY_WIDTH+1>(xy) + NEGATIVE_SHIFT; //now shifted to 0 ~ 2^64 - 1 , 65 bits signed\n\tap_uint<P_WIDTH> residue_unsigned32 = reduction_unsigned( ap_uint<XY_WIDTH>(xy_shift_signed65), p, idx_p );\n\tap_int<XY_WIDTH> residue_signed64 = ap_int<XY_WIDTH>(residue_unsigned32) - NEGATIVE_SHIFT_MOD[idx_p]; //now shifted back to -(p-1) ~ (p-1), 33 bits signed\n//#include <iostream>\n\t//cout << xy << \" :xy\" << endl;\n\t//cout << xy_shift_signed65 << \" :xy_shift_signed65\" << endl;\n\t//cout << residue_unsigned32 << \" :residue_unsigned32\" << endl;\n\t//cout << residue_signed64 << \" :residue_signed64\" << endl;\n\n\tif (idx_p == 7) return 0;\n\n#if CENTER_SHIFT == 0\n\tif(residue_signed64 < 0)\n\t\tresidue_signed64 += p;\n#elif CENTER_SHIFT == 1\n\tif(residue_signed64 > p/2)\n\t\tresidue_signed64 = residue_signed64 - p;\n\tif(residue_signed64 < -p/2)\n\t\tresidue_signed64 = residue_signed64 + p;\n#endif //CENTER_SHIFT\n\n\treturn ap_int<P_WIDTH>(residue_signed64);\n}\n\n//unsigned version\ninline ap_uint<P_WIDTH> reduction_unsigned(ap_uint<XY_WIDTH> xy, ap_uint<P_WIDTH> p, unsigned int idx_p){\n#pragma HLS PIPELINE\n#pragma HLS RESOURCE variable=MODULAR_TABLE core=ROM_nP_LUTRAM\n\n", "right_context": "\t\txy(top, base) = 0;\n\t\txy(base, base-MODULAR_TABLE_POWER) = xy(base, base-MODULAR_TABLE_POWER) + MODULAR_TABLE[idx_p][ window ];\n\t}\n\n\tfor(int i=0;i<2;i++){\n//#pragma HLS UNROLL //saves 2 cycles\n\t\tif(xy >= p)\n\t\t\txy -= p;\n\t}\n\n\treturn xy(P_WIDTH-1, 0);\n}\n\n}\n", "groundtruth": "\tap_uint<WINDOW_WIDTH> window;\n\tint base;\n\tfor_top:for(int top=XY_WIDTH-1;top>=MODULAR_TABLE_POWER;top-=(WINDOW_WIDTH-1)){// bits above top are defined to be all zeros.\n//#pragma HLS UNROLL factor=20\n\t\tbase = top - (WINDOW_WIDTH-1);\n", "crossfile_context": "", "source_line": 110, "groundtruth_line_count": 5, "why": "design path, hls kernel style code, behavioral compute logic", "related_tests": ["ACA-HLS/Final/Encrypted Computing/ACA-Final-Team1-Encrypted-Computing-main/src/host/host.cpp", "ACA-HLS/Final/Encrypted Computing/ACA-Final-Team1-Encrypted-Computing-main/tests/README.md"], "local_folder": "mod", "local_file": "mod/mod.cpp", "local_original_file": "mod/mod_original.cpp", "selection_score": 64}
{"task_id": "hls-spmv", "path": "hls-spmv/src/spmv.cpp", "left_context": "#include \"spmv.h\"\n\nvoid spmv(int rowPtr[NUM_ROWS+1], int columnIndex[NNZ],\n\t\tDTYPE values[NNZ], DTYPE y[SIZE], DTYPE x[SIZE])\n{\n", "right_context": "\t\tDTYPE y0 = 0;\n\tL2: for (int k = rowPtr[i]; k < rowPtr[i+1]; k++) {\n#pragma HLS pipeline\n\t\t\ty0 += values[k] * x[columnIndex[k]];\n\t\t}\n\t\ty[i] = y0;\n\t}\n}\n\n\nvoid mv(DTYPE A[SIZE][SIZE], DTYPE y[SIZE], DTYPE x[SIZE])\n{\n\tfor (int i = 0; i < SIZE; i++) {\n\t\tDTYPE y0 = 0;\n\t\tfor (int j = 0; j < SIZE; j++) {\n#pragma HLS pipeline\n\t\t\ty0 += A[i][j] * x[j];\n\t\t}\n\t\ty[i] = y0;\n\t}\n}\n\n", "groundtruth": "L1: for (int i = 0; i < NUM_ROWS; i++) {\n", "crossfile_context": "", "source_line": 6, "groundtruth_line_count": 1, "why": "design path, hls kernel style code, behavioral compute logic", "related_tests": ["hls-spmv/tb/spmv_test.cpp", "hls-spmv/tb/testcase.py"], "local_folder": "spmv", "local_file": "spmv/spmv.cpp", "local_original_file": "spmv/spmv_original.cpp", "selection_score": 64}
{"task_id": "hls-spmv", "path": "hls-spmv/src/spmv_fast_stream.cpp", "left_context": "#include \"spmv.h\"\n#include <hls_stream.h>\n\n#define II 9\n\nvoid spmv_kernel(\n\t\tint rows_length[NUM_ROWS],\n\t\tint rows_length_pad[NUM_ROWS],\n\t\tint cols[NNZ],\n\t\tDTYPE values[NNZ],\n\t\tDTYPE y[SIZE],\n\t\tDTYPE x[SIZE],\n\t\tint new_nnz)\n{\n#pragma HLS DATAFLOW\n\n\tint row_length_pad = 0, row_length = 0, k = 0, row_counter = 0;\n\thls::stream<DTYPE> values_fifo;\n\thls::stream<int>   cols_fifo;\n\thls::stream<DTYPE> results_fifo;\n\n\tDTYPE sum = 0;\n\tDTYPE value;\n\tint col;\n\tDTYPE term[II];\n\n\tfor (int i = 0; i < NNZ; i++) {\n#pragma HLS PIPELINE\n\t\tvalues_fifo << values[i];\n\t\tcols_fifo   << cols[i];\n\t}\n\n\tfor (int i = 0; i < new_nnz; i+=II) {\n#pragma HLS PIPELINE\n\t\tif (row_length_pad == 0) {\n\t\t\trow_length_pad = rows_length_pad[k];\n\t\t\trow_length = rows_length[k++];\n\t\t\trow_counter = 0;\n\t\t\tsum = 0;\n\t\t}\n\n\t\tfor (int j = 0; j < II; j++) {\n\t\t\trow_counter++;\n\t\t\tif (row_counter > row_length) {\n\t\t\t\tterm[j] = 0;\n\t\t\t} else {\n\t\t\t\tvalue = values_fifo.read();\n\t\t\t\tcol   = cols_fifo.read();\n\t\t\t\tterm[j] = value * x[col];\n\t\t\t}\n\t\t}\n\n\t\tDTYPE sum_tmp = 0;\n\t\tfor (int j = 0; j < II; j++) {\n\t\t\tsum_tmp += term[j];\n\t\t}\n\t\tsum += sum_tmp;\n\n\t\trow_length_pad -= II;\n\t\tif (row_length_pad == 0) {\n\t\t\tresults_fifo << sum;\n\t\t}\n\t}\n\n\tfor (int i = 0; i < NUM_ROWS; i++) {\n#pragma HLS PIPELINE\n\t\ty[i] = results_fifo.read();\n\t}\n}\n\n\nvoid spmv(int rowPtr[NUM_ROWS + 1], int cols[NNZ], DTYPE values[NNZ], DTYPE y[SIZE], DTYPE x[SIZE])\n{\n\t// rowPtr to rows_length\n\tint rows_length[NUM_ROWS] = {0};\n\tfor (int i = 1; i < NUM_ROWS + 1; i++) {\n#pragma HLS PIPELINE\n\t\trows_length[i - 1] = rowPtr[i] - rowPtr[i - 1];\n\t}\n\n\tint rows_length_pad[NUM_ROWS];\n\tint new_nnz = 0;\n\tfor (int i = 0; i < NUM_ROWS; i++) {\n", "right_context": "\t\t} else {\n\t\t\trows_length_pad[i] = r;\n\t\t\tnew_nnz += r;\n\t\t}\n\t}\n\n\tspmv_kernel(rows_length, rows_length_pad, cols, values, y, x, new_nnz);\n}\n", "groundtruth": "#pragma HLS PIPELINE\n\t\tint r = rows_length[i];\n\t\tint r_diff = r % II;\n\t\tif (r == 0) {\n\t\t\trows_length_pad[i] = II;\n", "crossfile_context": "", "source_line": 84, "groundtruth_line_count": 5, "why": "design path, hls kernel style code, behavioral compute logic", "related_tests": ["hls-spmv/tb/spmv_test.cpp", "hls-spmv/tb/testcase.py"], "local_folder": "spmv_fast_stream", "local_file": "spmv_fast_stream/spmv_fast_stream.cpp", "local_original_file": "spmv_fast_stream/spmv_fast_stream_original.cpp", "selection_score": 64}
{"task_id": "HLSBitNet", "path": "HLSBitNet/forward_llama_app_kernels/src/forward-unrolling.cpp", "left_context": "#include \"forward.h\"\n#include \"config.h\"\n#include <cstring>\n\n// TODO: include HLS math package\n#include \"hls_math.h\"\n\n// neural net blocks; the dynamics of the Transformer\ntemplate <int S>\n\n// o = output, x = input, weight = array of gain params\nvoid rmsnorm(float o[S], float x[S], float weight[S]) {\n#pragma HLS INLINE off\n#pragma HLS ALLOCATION instances = fmul limit = 1 operation\n#pragma HLS ALLOCATION instances = fadd limit = 1 operation\n#pragma HLS ALLOCATION instances = fdiv limit = 1 operation\n#pragma HLS ALLOCATION instances = fsqrt limit = 1 operation\n\n  // calculate sum of squares\n  float ss = 0.0f;\nsum_of_squares:\n  for (int j = 0; j < S; j++) {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor = 1\n    float x_j = x[j];\n    ss += x_j * x_j;\n  }\n  ss /= S;\n  ss += 1e-5f;\n  ss = 1.0f / hls::sqrtf(ss);\n// normalize and scale\nnorm_and_scale:\n  for (int j = 0; j < S; j++) {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor = 1\n    // o[j] = weight[j] * (ss * x[j]);\n    float x_j = x[j];\n    float weight_j = weight[j];\n    o[j] = weight_j * (ss * x_j);\n  }\n}\n\ntemplate <int MAXSIZE> void softmax(float *x, int size) {\n#pragma HLS INLINE off\n#pragma HLS ALLOCATION instances = fcmp limit = 1 operation\n#pragma HLS ALLOCATION instances = fadd limit = 1 operation\n#pragma HLS ALLOCATION instances = fmul limit = 1 operation\n#pragma HLS ALLOCATION instances = fdiv limit = 1 operation\n#pragma HLS ALLOCATION instances = fsub limit = 1 operation\n\n  // find max value (for numerical stability)\n  float buffer[MAXSIZE];\n#pragma HLS ARRAY_RESHAPE variable = buffer type = complete dim = 0\n  float max_val = x[0];\nmax:\n  for (int i = 1; i < size; i++) {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor = 1\n    float x_i = x[i];\n    if (x_i > max_val) {\n      max_val = x_i;\n    }\n  }\n  // exp and sum\n\nexp:\n  for (int i = 0; i < size; i++) {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor = 1\n    float x_i = hls::expf(x[i] - max_val);\n    buffer[i] = x_i;\n  }\n  float sum = 0.0f;\nsum:\n  for (int i = 0; i < size; i++) {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor = 1\n    sum += buffer[i];\n", "right_context": "}\n\ntemplate <int N, int D>\nvoid matmul(float *xout, int8_t *xq, float *xs, int8_t *wq, float *ws) {\n#pragma HLS INLINE off\n  // W (d,n) @ x (n,) -> xout (d,)\n  // by far the most amount of time is spent inside this little function\n  // inputs to this function are both quantized\n  // wq - quantized weight matrix\n  // ws - scaling factor for each row of wq\n  // xq - quantized input vector\n  // xs - scaling factor for xq\n  // xout - output vector\n  static int8_t x_buffer[N];\n#pragma HLS ARRAY_RESHAPE variable = x_buffer type = block factor = 2 dim = 1\n  static float xs_buffer[N / GS];\n#pragma HLS ARRAY_RESHAPE variable = x_buffer type = block factor = 2 dim = 1\nx_buff:\n  for (int i = 0; i < N; i++) {\n#pragma HLS UNROLL\n    x_buffer[i] = xq[i];\n  }\nxs_buff:\n  for (int j = 0; j <= N - GS; j += GS) {\n#pragma HLS UNROLL\n    xs_buffer[j / GS] = xs[j / GS];\n  }\n\nmatmul1:\n// Iterate over each row of the weight matrix\n#pragma HLS UNROLL factor = 4\n  for (int i = 0; i < D; i++) {\n    float val = 0.0f;\n    const int w_row_offset = i * N;\n    const int ws_row_offset = i * (N / GS);\n  // do the matmul in groups of GS\n  matmul2:\n    for (int j = 0; j <= N - GS; j += GS) {\n#pragma HLS UNROLL factor = 4\n      int32_t ival = 0;\n    matmul3:\n#pragma HLS UNROLL factor = 4\n      for (int k = 0; k < GS; k++) {\n        int32_t buffer1 = (int32_t)x_buffer[j + k];\n        // Read directly from the weight matrix in global memory\n        int32_t buffer2 = (int32_t)wq[w_row_offset + j + k];\n        if (buffer1 == -1)\n          ival -= buffer2;\n        if (buffer1 == 1)\n          ival += buffer2;\n      }\n      // Read directly from the scaling factors in global memory\n      val += ((float)ival) * ws[ws_row_offset + j / GS] * xs_buffer[j / GS];\n    }\n    xout[i] = val;\n  }\n}\n\nextern \"C\" void\nforward(Transformer<dim, hidden_dim, n_layers, n_heads, n_kv_heads, vocab_size,\n                    seq_len, GS> *transformer,\n        int token, int pos,\n        float key_cache[n_layers * seq_len * ((dim * n_kv_heads) / n_heads)],\n        float value_cache[n_layers * seq_len * ((dim * n_kv_heads) / n_heads)],\n        float *out) {\n#pragma HLS INTERFACE m_axi port = transformer offset = slave bundle = gmem0\n#pragma HLS INTERFACE m_axi port = out offset = slave bundle = gmem1\n\n// Area optimization directives\n#pragma HLS ALLOCATION instances = fadd limit = 2 operation\n#pragma HLS ALLOCATION instances = fmul limit = 2 operation\n#pragma HLS ALLOCATION instances = fsub limit = 1 operation\n#pragma HLS ALLOCATION instances = fdiv limit = 1 operation\n#pragma HLS ALLOCATION instances = fcmp limit = 1 operation\n#pragma HLS ALLOCATION instances = fsqrt limit = 1 operation\n#pragma HLS ALLOCATION instances = add limit = 2 operation\n#pragma HLS ALLOCATION instances = mul limit = 2 operation\n#pragma HLS ALLOCATION instances = rmsnorm limit = 1 function\n#pragma HLS ALLOCATION instances = matmul limit = 1 function\n#pragma HLS ALLOCATION instances = softmax limit = 1 function\n\n  // a few convenience variables\n  auto w = &transformer->weights;\n  static float x[config.dim]; // activation at current time stamp (dim,)\n#pragma HLS ARRAY_RESHAPE variable = x type = block factor = 4 dim = 1\n  static float xb[config.dim]; // same, but inside a residual branch (dim,)\n#pragma HLS ARRAY_RESHAPE variable = xb type = block factor = 4 dim = 1\n  static float\n      xb2[config.dim]; // an additional buffer just for convenience (dim,)\n#pragma HLS ARRAY_RESHAPE variable = xb2 type = block factor = 4 dim = 1\n  static float hb[config.hidden_dim]; // buffer for hidden dimension in the ffn\n                                      // (hidden_dim,)\n#pragma HLS ARRAY_RESHAPE variable = hb type = block factor = 4 dim = 1\n  static float hb2[config.hidden_dim]; // buffer for hidden dimension in the ffn\n                                       // (hidden_dim,)\n#pragma HLS ARRAY_RESHAPE variable = hb2 type = block factor = 4 dim = 1\n  static QuantizedTensor<config.dim> xq;        // quantized x (dim,)\n  static QuantizedTensor<config.hidden_dim> hq; // quantized hb (hidden_dim,)\n  static float q[config.dim];                   // query (dim,)\n#pragma HLS ARRAY_RESHAPE variable = q type = block factor = 4 dim = 1\n  static float\n      k[(config.dim * config.n_kv_heads) / config.n_heads]; // key (dim,)\n#pragma HLS ARRAY_RESHAPE variable = k type = block factor = 4 dim = 1\n  static float\n      v[(config.dim * config.n_kv_heads) / config.n_heads]; // value (dim,)\n#pragma HLS ARRAY_RESHAPE variable = v type = block factor = 4 dim = 1\n  static float\n      att[config.n_heads * config.seq_len]; // buffer for scores/attention\n                                            // values (n_heads, seq_len)\n#pragma HLS ARRAY_RESHAPE variable = att type = block factor = 4 dim = 1\n\n  constexpr int kv_dim = (config.dim * config.n_kv_heads) / config.n_heads;\n  constexpr int kv_mul =\n      config.n_heads /\n      config.n_kv_heads; // integer multiplier of the kv sharing in multiquery\n  constexpr int head_size = dim / config.n_heads;\n\n  // copy the token embedding into x\n  std::memcpy(x, w->token_embedding_table + token * dim, dim * sizeof(float));\n\n// forward all the layers\nmain_forward_loop:\n  for (int l = 0; l < config.n_layers; l++) {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor = 1\n    // attention rmsnorm\n    rmsnorm<dim>(xb, x, w->rms_att_weight + l * dim);\n\n    // qkv matmuls for this position\n    quantize(&xq, xb, GS);\n    matmul<dim, dim>(q, xq.q, xq.s, (w->wq + l)->q, (w->wq + l)->s);\n    matmul<dim, kv_dim>(k, xq.q, xq.s, (w->wk + l)->q, (w->wk + l)->s);\n    matmul<dim, kv_dim>(v, xq.q, xq.s, (w->wv + l)->q, (w->wv + l)->s);\n\n  // RoPE relative positional encoding: complex-valued rotate q and k in each\n  // head Process the portion where both query and key vectors are involved (i <\n  // kv_dim)\n  rotation1:\n    // Rotation for both query and key vectors (i < kv_dim)\n    for (int i = 0; i < kv_dim; i += 2) {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor = 1\n      int head_dim = i % head_size;\n      float freq = 1.0f / hls::powf(10000.0f, head_dim / (float)head_size);\n      float val = pos * freq;\n      float fcr, fci;\n      hls::sincosf(val, &fci, &fcr);\n\n      // Rotate the query vector\n      float v0_q = q[i];\n      float v1_q = q[i + 1];\n      q[i] = v0_q * fcr - v1_q * fci;\n      q[i + 1] = v0_q * fci + v1_q * fcr;\n\n      // Rotate the key vector\n      float v0_k = k[i];\n      float v1_k = k[i + 1];\n      k[i] = v0_k * fcr - v1_k * fci;\n      k[i + 1] = v0_k * fci + v1_k * fcr;\n    }\n  rotation2:\n    // Rotation for only the query vector (i >= kv_dim)\n    for (int i = kv_dim; i < dim; i += 2) {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor = 1\n      int head_dim = i % head_size;\n      float freq = 1.0f / hls::powf(10000.0f, head_dim / (float)head_size);\n      float val = pos * freq;\n      float fcr, fci;\n      hls::sincosf(val, &fci, &fcr);\n\n      // Rotate only the query vector\n      float v0 = q[i];\n      float v1 = q[i + 1];\n      q[i] = v0 * fcr - v1 * fci;\n      q[i + 1] = v0 * fci + v1 * fcr;\n    }\n    // save key,value at this time step (pos) to our kv cache\n    int loff =\n        l * config.seq_len * kv_dim; // kv cache layer offset for convenience\n    float *key_cache_row = key_cache + loff + pos * kv_dim;\n    float *value_cache_row = value_cache + loff + pos * kv_dim;\n\n    std::memcpy(key_cache_row, k, kv_dim * sizeof(*key_cache_row));\n    std::memcpy(value_cache_row, v, kv_dim * sizeof(*value_cache_row));\n\n    // multihead attention. iterate over all heads\n    int h;\n\n  multihead_attention:\n    for (h = 0; h < n_heads; h++) {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor = 1\n      const int q_offset = h * head_size;\n      const int att_offset = h * seq_len;\n    iterate:\n      for (int t = 0; t <= pos; t++) {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor = 1\n        const int key_offset = loff + t * kv_dim + (h / kv_mul) * head_size;\n        float score = 0.0f;\n        for (int i = 0; i < head_size; i++) {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor = 1\n          score += q[i + q_offset] * key_cache[i + key_offset];\n        }\n        score /= hls::sqrtf(head_size);\n        att[t + att_offset] = score;\n      }\n\n      softmax<257>(att + att_offset, pos + 1);\n\n      const int xb_offset = h * head_size;\n      memset(xb + xb_offset, 0, head_size * sizeof(float));\n    acc:\n      for (int t = 0; t <= pos; t++) {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor = 1\n        const int v_offset = loff + t * kv_dim + (h / kv_mul) * head_size;\n        float a = att[t + att_offset];\n      acc_inner:\n        for (int i = 0; i < head_size; i++) {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor = 1\n          xb[i + xb_offset] += a * value_cache[i + v_offset];\n        }\n      }\n    }\n\n    // final matmul to get the output of the attention\n    quantize(&xq, xb, GS);\n    matmul<dim, dim>(xb2, xq.q, xq.s, (w->wo + l)->q, (w->wo + l)->s);\n\n  residual:\n    for (int i = 0; i < dim; i++) {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor = 1\n      x[i] += xb2[i];\n    }\n\n    // ffn rmsnorm\n    rmsnorm<dim>(xb, x, w->rms_ffn_weight + l * dim);\n\n    // Now for FFN in PyTorch we have: self.w2(F.silu(self.w1(x)) * self.w3(x))\n    quantize(&xq, xb, GS);\n    matmul<dim, hidden_dim>(hb, xq.q, xq.s, (w->w1 + l)->q, (w->w1 + l)->s);\n    matmul<dim, hidden_dim>(hb2, xq.q, xq.s, (w->w3 + l)->q, (w->w3 + l)->s);\n    float hb_out[hidden_dim];\n#pragma HLS ARRAY_RESHAPE variable = hb_out type = block factor = 4 dim = 1\n  swi_glu:\n    for (int i = 0; i < hidden_dim; i++) {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor = 1\n      float val = hb[i];\n      // silu(x)=x*σ(x), where σ(x) is the logistic sigmoid\n      val *= (1.0f / (1.0f + hls::expf(-val)));\n      // elementwise multiply with w3(x)\n      val *= hb2[i];\n      hb_out[i] = val;\n    }\n    std::memcpy(hb, hb_out, hidden_dim * sizeof(float));\n\n    quantize(&hq, hb, GS);\n    matmul<hidden_dim, dim>(xb, hq.q, hq.s, (w->w2 + l)->q, (w->w2 + l)->s);\n\n  residual2:\n    for (int i = 0; i < dim; i++) {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor = 1\n      x[i] += xb[i];\n    }\n  }\n\n  // final rmsnorm\n  rmsnorm<dim>(x, x, w->rms_final_weight);\n\n  // classifier into logits\n  quantize(&xq, x, GS);\n  matmul<dim, vocab_size>(out, xq.q, xq.s, w->wcls->q, w->wcls->s);\n}", "groundtruth": "  }\n  // normalize\n  const float inv_sum = 1.0 / sum;\nnorm:\n  for (int i = 0; i < size; i++) {\n", "crossfile_context": "", "source_line": 79, "groundtruth_line_count": 5, "why": "design path, hls kernel style code, behavioral compute logic", "related_tests": ["HLSBitNet/cpu_benchmarks/test.c"], "local_folder": "forward-unrolling", "local_file": "forward-unrolling/forward-unrolling.cpp", "local_original_file": "forward-unrolling/forward-unrolling_original.cpp", "selection_score": 63}
{"task_id": "ACA-HLS", "path": "ACA-HLS/Final/Encrypted Computing/ACA-Final-Team1-Encrypted-Computing-main/src/kernel/K_ntt.cpp", "left_context": "//#include \"ntt.h\"\n#include \"rns.h\"\n#include <iostream>\n\nusing namespace std;\n\nextern \"C\" {\nconst int PRAGMA_UNROLL_NUM_NTT = UNROLL_NUM_NTT;\nconst int PRAGMA_RNS_NUM = RNS_NUM;\n\nvoid add_sub(ap_int<PRIME_BIT> *a, ap_int<PRIME_BIT> *b, ap_uint<PRIME_BIT> mod) {\n    ap_int<PRIME_BIT+1> ta, tb;\n    ta = *a + *b;\n    tb = *a - *b;\n    if (ta > mod/2)\n        ta -= mod;\n    if (ta < -mod/2)\n        ta += mod;\n    if (tb > mod/2)\n        tb -= mod;\n    if (tb < -mod/2)\n        tb += mod;\n    *a = ta;\n    *b = tb;\n}\n\nap_int<PRIME_BIT> mul_mod(ap_int<PRIME_BIT> a,\n                          ap_int<PRIME_BIT> b,\n                          ap_uint<PRIME_BIT> mod,\n                          ap_int<PRIME_BIT> mprime)\n{\n    ap_int<2*PRIME_BIT> temp = ((a) * (b));\n    ap_int<PRIME_BIT> lower = (ap_int<PRIME_BIT>)temp(PRIME_BIT-1, 0) * (ap_int<PRIME_BIT>)mprime;\n    ap_int<2*PRIME_BIT> acc = lower * mod;\n    acc = acc + temp;\n    ap_int<PRIME_BIT> ret = acc(2*PRIME_BIT-1, PRIME_BIT);\n    if (ret > mod/2)\n        ret -= mod;\n    if (ret < -mod/2)\n        ret += mod;\n    return ret;\n}\n\nvoid butterfly(ap_uint<2*PRIME_BIT> ta,\n               ap_int<PRIME_BIT> c,\n               bool inv,\n               ap_int<PRIME_BIT> *ttta,\n               ap_int<PRIME_BIT> *tttb,\n               ap_uint<PRIME_BIT> mod,\n               ap_int<PRIME_BIT> mprime)\n{\n#pragma HLS ALLOCATION instances=mul_mod limit=1 function\n#pragma HLS ALLOCATION instances=add_sub limit=2 function\n\n    ap_int<PRIME_BIT> tta, ttb;\n    tta = ta(PRIME_BIT-1, 0);\n    ttb = ta(2*PRIME_BIT-1, PRIME_BIT);\n    if (inv) {\n        add_sub(&tta, &ttb, mod);\n        ttb = mul_mod(ttb, c, mod, mprime);\n    } else {\n        ttb = mul_mod(ttb, c, mod, mprime);\n        add_sub(&tta, &ttb, mod);\n    }\n    *ttta = tta;\n    *tttb