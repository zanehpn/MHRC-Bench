+        tb_path = FV / folder / tb_name
+        write(tb_path, textwrap.dedent(runtime_testbenches[folder]))
+        row["local_testbench"] = f"{folder}/{tb_name}"
+        row["testbench_kind"] = "dut_target_tb"
+    else:
