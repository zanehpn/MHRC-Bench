+        "core_2": "anisotropic_diffusion(...)",
+        "simple_fullpfalgo": "simple_fullpfalgo(...) family",
+        "rf_doppler_spoof_engine": "rf_doppler_spoof_engine(...)",
+        "aes": "aes_encrypt(...) and helpers",
