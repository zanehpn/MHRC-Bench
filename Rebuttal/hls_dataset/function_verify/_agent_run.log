/usr/bin/bash -lc "python - <<'PY'
import json, os, re
base='/ssd1/zqy/Multi-hdl-language-repo'
manifest=f'{base}/hls_dataset/function_verify/design_function_verify_candidates_50.jsonl'
for idx,line in enumerate(open(manifest),1):
    row=json.loads(line)
    path=os.path.join(base,'hls_dataset/function_verify',row['local_file'])
    text=open(path,errors='ignore').read()
    sigs=[]
    for m in re.finditer(r'("'^|'"\\n)([A-Za-z_][\\w:<>,\\s\\*&\\[\\]]*?)\\s+([A-Za-z_]\\w*)\\s*\\((["'^;{}]*)'"\\)\\s*\\{', text):
        ret=' '.join(m.group(2).split())
        name=m.group(3)
        if name in {'if','for','while','switch'}: continue
        sigs.append(f'{ret} {name}({\" \".join(m.group(4).split())})')
        if len(sigs)>=6: break
    print(f'{idx:02d} {row[\"local_folder\"]}:')
    for s in sigs: print('  ',s)
