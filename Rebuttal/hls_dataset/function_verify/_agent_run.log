0; i < size; i++) {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor = 1\n    float x_i = hls::expf(x[i] - max_val);\n    buffer[i] = x_i;\n  }\n  float sum = 0.0f;\nsum:\n  for (int i = 0; i < size; i++) {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor = 1\n    sum += buffer[i];\n  }\n  // normalize\n  const float inv_sum = 1.0 / sum;\nnorm:\n  for (int i = 0; i < size; i++) {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor = 1\n    x[i] = buffer[i] * inv_sum;\n  }\n}\n\ntemplate <int N, int D>\nvoid matmul(float *xout, int8_t *xq, float *xs, int8_t *wq, float *ws) {\n#pragma HLS INLINE off\n\n  // W (d,n) @ x (n,) -> xout (d,)\n  static int8_t x_buffer[N];\n#pragma HLS ARRAY_PARTITION variable = x_buffer type = cyclic factor =         \\\n    GS dim = 1\n\n  static float xs_buffer[N / GS];\n#pragma HLS ARRAY_PARTITION variable = xs_buffer type = cyclic factor =        \\\n    GS dim = 1\n\n  // Load xq and xs into local buffers\nx_buff:\n  for (int i = 0; i < N; i++) {\n#pragma HLS pipeline II = 1\n    x_buffer[i] = xq[i];\n  }\nxs_buff:\n  for (int j = 0; j <= N - GS; j += GS) {\n#pragma HLS pipeline II = 1\n    xs_buffer[j / GS] = xs[j / GS];\n  }\n\nmatmul1:\n  for (int i = 0; i < D; i++) {\n    const int w_row_offset = i * N;\n    const int ws_row_offset = i * (N / GS);\n\n    xout[i] = 0.0f;\n\n  matmul2:\n    for (int j = 0; j <= N - GS; j += GS) {\n#pragma HLS pipeline II = 1\n", "right_context": "    matmul3:\n      for (int k = 0; k < GS; k++) {\n#pragma HLS pipeline II = 1\n        int8_t in_val = x_buffer[j + k];\n        int8_t w_val = wq[w_row_offset + j + k];\n        if (in_val == 1)\n          ival += w_val;\n        else if (in_val == -1)\n          ival -= w_val;\n      }\n      // store partial result in array\n      xout[i] += ((float)ival) * ws[ws_row_offset + j / GS] * xs_buffer[j / GS];\n    }\n  }\n}\n\nextern \"C\" void\nforward(Transformer<dim, hidden_dim, n_layers, n_heads, n_kv_heads, vocab_size,\n                    seq_len, GS> *transformer,\n        int token, int pos,\n        float key_cache[n_layers * seq_len * ((dim * n_kv_heads) / n_heads)],\n        float value_cache[n_layers * seq_len * ((dim * n_kv_heads) / n_heads)],\n        float *out) {\n#pragma HLS INTERFACE m_axi port = transformer offset = slave bundle = gmem0\n#pragma HLS INTERFACE m_axi port = out offset = slave bundle = gmem1\n\n// Area optimization directives\n#pragma HLS ALLOCATION instances = fadd limit = 2 operation\n#pragma HLS ALLOCATION instances = fmul limit = 2 operation\n#pragma HLS ALLOCATION instances = fsub limit = 1 operation\n#pragma HLS ALLOCATION instances = fdiv limit = 1 operation\n#pragma HLS ALLOCATION instances = fcmp limit = 1 operation\n#pragma HLS ALLOCATION instances = fsqrt limit = 1 operation\n#pragma HLS ALLOCATION instances = add limit = 2 operation\n#pragma HLS ALLOCATION instances = mul limit = 2 operation\n#pragma HLS ALLOCATION instances = rmsnorm limit = 1 function\n#pragma HLS ALLOCATION instances = matmul limit = 1 function\n#pragma HLS ALLOCATION instances = softmax limit = 1 function\n\n  // a few convenience variables\n  auto w = &transformer->weights;\n  static float x[config.dim]; // activation at current time stamp (dim,)\n#pragma HLS ARRAY_RESHAPE variable = x type = block factor = 4 dim = 1\n  static float xb[config.dim]; // same, but inside a residual branch (dim,)\n#pragma HLS ARRAY_RESHAPE variable = xb type = block factor = 4 dim = 1\n  static float\n      xb2[config.dim]; // an additional buffer just for convenience (dim,)\n#pragma HLS ARRAY_RESHAPE variable = xb2 type = block factor = 4 dim = 1\n  static float hb[config.hidden_dim]; // buffer for hidden dimension in the ffn\n                                      // (hidden_dim,)\n#pragma HLS ARRAY_RESHAPE variable = hb type = block factor = 4 dim = 1\n  static float hb2[config.hidden_dim]; // buffer for hidden dimension in the ffn\n                                       // (hidden_dim,)\n#pragma HLS ARRAY_RESHAPE variable = hb2 type = block factor = 4 dim = 1\n  static QuantizedTensor<config.dim> xq;        // quantized x (dim,)\n  static QuantizedTensor<config.hidden_dim> hq; // quantized hb (hidden_dim,)\n  static float q[config.dim];                   // query (dim,)\n#pragma HLS ARRAY_RESHAPE variable = q type = block factor = 4 dim = 1\n  static float\n      k[(config.dim * config.n_kv_heads) / config.n_heads]; // key (dim,)\n#pragma HLS ARRAY_RESHAPE variable = k type = block factor = 4 dim = 1\n  static float\n      v[(config.dim * config.n_kv_heads) / config.n_heads]; // value (dim,)\n#pragma HLS ARRAY_RESHAPE variable = v type = block factor = 4 dim = 1\n  static float\n      att[config.n_heads * config.seq_len]; // buffer for scores/attention\n                                            // values (n_heads, seq_len)\n#pragma HLS ARRAY_RESHAPE variable = att type = block factor = 4 dim = 1\n\n  constexpr int kv_dim = (config.dim * config.n_kv_heads) / config.n_heads;\n  constexpr int kv_mul =\n      config.n_heads /\n      config.n_kv_heads; // integer multiplier of the kv sharing in multiquery\n  constexpr int head_size = dim / config.n_heads;\n\n  // copy the token embedding into x\n  std::memcpy(x, w->token_embedding_table + token * dim, dim * sizeof(float));\n\n// forward all the layers\nmain_forward_loop:\n  for (int l = 0; l < config.n_layers; l++) {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor = 1\n    // attention rmsnorm\n    rmsnorm<dim>(xb, x, w->rms_att_weight + l * dim);\n\n    // qkv matmuls for this position\n    quantize(&xq, xb, GS);\n    matmul<dim, dim>(q, xq.q, xq.s, (w->wq + l)->q, (w->wq + l)->s);\n    matmul<dim, kv_dim>(k, xq.q, xq.s, (w->wk + l)->q, (w->wk + l)->s);\n    matmul<dim, kv_dim>(v, xq.q, xq.s, (w->wv + l)->q, (w->wv + l)->s);\n\n  // RoPE relative positional encoding: complex-valued rotate q and k in each\n  // head Process the portion where both query and key vectors are involved (i <\n  // kv_dim)\n  rotation1:\n    // Rotation for both query and key vectors (i < kv_dim)\n    for (int i = 0; i < kv_dim; i += 2) {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor = 1\n      int head_dim = i % head_size;\n      float freq = 1.0f / hls::powf(10000.0f, head_dim / (float)head_size);\n      float val = pos * freq;\n      float fcr, fci;\n      hls::sincosf(val, &fci, &fcr);\n\n      // Rotate the query vector\n      float v0_q = q[i];\n      float v1_q = q[i + 1];\n      q[i] = v0_q * fcr - v1_q * fci;\n      q[i + 1] = v0_q * fci + v1_q * fcr;\n\n      // Rotate the key vector\n      float v0_k = k[i];\n      float v1_k = k[i + 1];\n      k[i] = v0_k * fcr - v1_k * fci;\n      k[i + 1] = v0_k * fci + v1_k * fcr;\n    }\n  rotation2:\n    // Rotation for only the query vector (i >= kv_dim)\n    for (int i = kv_dim; i < dim; i += 2) {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor = 1\n      int head_dim = i % head_size;\n      float freq = 1.0f / hls::powf(10000.0f, head_dim / (float)head_size);\n      float val = pos * freq;\n      float fcr, fci;\n      hls::sincosf(val, &fci, &fcr);\n\n      // Rotate only the query vector\n      float v0 = q[i];\n      float v1 = q[i + 1];\n      q[i] = v0 * fcr - v1 * fci;\n      q[i + 1] = v0 * fci + v1 * fcr;\n    }\n    // save key,value at this time step (pos) to our kv cache\n    int loff =\n        l * config.seq_len * kv_dim; // kv cache layer offset for convenience\n    float *key_cache_row = key_cache + loff + pos * kv_dim;\n    float *value_cache_row = value_cache + loff + pos * kv_dim;\n\n    std::memcpy(key_cache_row, k, kv_dim * sizeof(*key_cache_row));\n    std::memcpy(value_cache_row, v, kv_dim * sizeof(*value_cache_row));\n\n    // multihead attention. iterate over all heads\n    int h;\n\n  multihead_attention:\n    for (h = 0; h < n_heads; h++) {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor = 1\n      const int q_offset = h * head_size;\n      const int att_offset = h * seq_len;\n    iterate:\n      for (int t = 0; t <= pos; t++) {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor = 1\n        const int key_offset = loff + t * kv_dim + (h / kv_mul) * head_size;\n        float score = 0.0f;\n        for (int i = 0; i < head_size; i++) {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor = 1\n          score += q[i + q_offset] * key_cache[i + key_offset];\n        }\n        score /= hls::sqrtf(head_size);\n        att[t + att_offset] = score;\n      }\n\n      softmax<257>(att + att_offset, pos + 1);\n\n      const int xb_offset = h * head_size;\n      memset(xb + xb_offset, 0, head_size * sizeof(float));\n    acc:\n      for (int t = 0; t <= pos; t++) {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor = 1\n        const int v_offset = loff + t * kv_dim + (h / kv_mul) * head_size;\n        float a = att[t + att_offset];\n      acc_inner:\n        for (int i = 0; i < head_size; i++) {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor = 1\n          xb[i + xb_offset] += a * value_cache[i + v_offset];\n        }\n      }\n    }\n\n    // final matmul to get the output of the attention\n    quantize(&xq, xb, GS);\n    matmul<dim, dim>(xb2, xq.q, xq.s, (w->wo + l)->q, (w->wo + l)->s);\n\n  residual:\n    for (int i = 0; i < dim; i++) {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor = 1\n      x[i] += xb2[i];\n    }\n\n    // ffn rmsnorm\n    rmsnorm<dim>(xb, x, w->rms_ffn_weight + l * dim);\n\n    // Now for FFN in PyTorch we have: self.w2(F.silu(self.w1(x)) * self.w3(x))\n    quantize(&xq, xb, GS);\n    matmul<dim, hidden_dim>(hb, xq.q, xq.s, (w->w1 + l)->q, (w->w1 + l)->s);\n    matmul<dim, hidden_dim>(hb2, xq.q, xq.s, (w->w3 + l)->q, (w->w3 + l)->s);\n    float hb_out[hidden_dim];\n#pragma HLS ARRAY_RESHAPE variable = hb_out type = block factor = 4 dim = 1\n  swi_glu:\n    for (int i = 0; i < hidden_dim; i++) {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor = 1\n      float val = hb[i];\n      // silu(x)=x*σ(x), where σ(x) is the logistic sigmoid\n      val *= (1.0f / (1.0f + hls::expf(-val)));\n      // elementwise multiply with w3(x)\n      val *= hb2[i];\n      hb_out[i] = val;\n    }\n    std::memcpy(hb, hb_out, hidden_dim * sizeof(float));\n\n    quantize(&hq, hb, GS);\n    matmul<hidden_dim, dim>(xb, hq.q, hq.s, (w->w2 + l)->q, (w->w2 + l)->s);\n\n  residual2:\n    for (int i = 0; i < dim; i++) {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor = 1\n      x[i] += xb[i];\n    }\n  }\n\n  // final rmsnorm\n  rmsnorm<dim>(x, x, w->rms_final_weight);\n\n  // classifier into logits\n  quantize(&xq, x, GS);\n  matmul<dim, vocab_size>(out, xq.q, xq.s, w->wcls->q, w->wcls->s);\n}\n", "groundtruth": "      int8_t ival = 0;\n", "crossfile_context": "", "source_line": 125, "groundtruth_line_count": 1, "why": "design path, hls kernel style code, has related tests", "related_tests": ["HLSBitNet/cpu_benchmarks/test.c"], "local_folder": "forward", "local_file": "forward/forward.cpp", "local_original_file": "forward/forward_original.cpp", "selection_score": 57}
{"task_id": "hl5", "path": "hl5/src/execute.cpp", "left_context": "/* Copyright 2017 Columbia University, SLD Group */\n\n//\n// execute.cpp - Robert Margelli\n// Implementation of the execute stage\n//\n\n#include \"execute.hpp\"\n\nu_div_res_t execute::udiv_func(sc_uint<XLEN> num, sc_uint<XLEN> den)\n{\n\tsc_uint<XLEN> rem;\n\tsc_uint<XLEN> quotient;\n\tu_div_res_t u_div_res;\n\n\trem = 0;\n\tquotient = 0;\n\nDIVIDE_LOOP:\n\tfor(sc_int<6> i = 31; i >= 0; i--){\n\t\t// Break EXE stage protocol for DSE\n\t\tHLS_BREAK_PROTOCOL(\"div_break_proto\");\n\t\tDIV_UNROLL;\n\n\t\tconst sc_uint<XLEN> mask = BIT(i);\n\t\tconst sc_uint<XLEN> lsb = (mask & num) >> i;\n\n\t\trem = rem << 1;\n\t\trem = rem | lsb;\n\n\t\tif(rem >= den){\n\t\t\trem -= den;\n\t\t\tquotient = quotient | mask;\n\t\t}\n\t}\n\n\tu_div_res.quotient = quotient;\n\tu_div_res.remainder = rem;\n\n\treturn u_div_res;\n}\n\n\ndiv_res_t execute::div_func(sc_int<XLEN> num, sc_int<XLEN> den)\n{\n\tbool num_neg;\n\tbool den_neg;\n\tdiv_res_t div_res;\n\tu_div_res_t u_div_res;\n\n\tnum_neg = num < 0;\n\tden_neg = den < 0;\n\n\tif(num_neg)\n\t\tnum = -num;\n\tif(den_neg)\n\t\tden = -den;\n\n\tu_div_res = udiv_func((sc_uint<XLEN>) num, (sc_uint<XLEN>) den);\n\tdiv_res.quotient = (sc_int<XLEN>)u_div_res.quotient;\n\tdiv_res.remainder = (sc_int<XLEN>)u_div_res.remainder;\n\n\tif(num_neg ^ den_neg)\n\t\tdiv_res.quotient = -div_res.quotient;\n\telse\n\t\tdiv_res.quotient =  div_res.quotient;\n\n\treturn div_res;\n}\n\nvoid execute::perf_th(void)\n{\nPERF_RST:\n\t{\n\t\tPROTO_PERF_RST;\n\n                csr[MCYCLE_I] = 0x0; // Cycle count (32-bits only for now)\n\t\twait();\n\t\twait();\n\t}\n\n        while (true) {\n            PROTO_PERF_BODY;\n            csr[MCYCLE_I]++;\n            wait();\n        }\n\n}\n\nvoid execute::execute_th(void)\n{\nEXE_RST:\n\t{\n\t\tPROTO_EXE_RST;\n\t\tdin.reset_get();\n\t\tdout.reset_put();\n\t\toutput.tag = 0;\n\n                csr[MISA_I] = 0x40001101; // RV32IMA\n                csr[MARCHID_I] = 0x0; // Not implemented (should be assigned by RISC-V\n                csr[MIMPID_I] = 0x0; // Not implemented (processor revision)\n                csr[MHARTID_I] = 0x0; // Single thread (always 0)\n                csr[MINSTRET_I] = 0x0; // Retired instructions\n\t\twait();\n\t\twait();\n\t}\n\nEXE_BODY:\n\twhile(true) {\n\t\tPROTO_EXE_BODY;\n\t\tMUL_SPLIT;\n\t\tADD_SPLIT;\n\n\t\t// Get\n\t\tinput = din.get();\n\n\t\t// Compute\n\t\toutput.regwrite = input.regwrite;\n\t\toutput.memtoreg = input.memtoreg;\n\t\toutput.ld = input.ld;\n\t\toutput.st = input.st;\n\t\toutput.dest_reg = input.dest_reg;\n\t\toutput.mem_datain = input.rs2;\n\t\toutput.tag = input.tag;\n\n                bool nop = false;\n                if (input.regwrite == \"0\" &&\n                    input.ld == NO_LOAD &&\n                    input.st == NO_STORE &&\n                    input.alu_op ==  (sc_bv<ALUOP_SIZE>)ALUOP_NULL)\n                    nop = true;\n\n#ifdef MUL64\n\t\t// 64-bit temporary multiplication result, for upper 32 bit multiplications (MULH, MULHU, MULHSU).\n\t\t__int64_t tmp_mul_res = 0;\n#endif\n#ifdef DIV\n\t\t// Temporary division results.\n\t\tdiv_res_t div_res = {0, 0};\n\t\tu_div_res_t u_div_res = {0, 0};\n#endif\n#ifdef CSR_LOGIC\n\t\t// Temporary CSR index\n\t\tsc_uint<CSR_IDX_LEN> csr_index = 0;\n#endif\n\n\t\t// Sign extend the immediate operand for I-type instructions.\n\t\tsc_bv<XLEN> tmp_sigext_imm_i = sc_bv<XLEN>(0);\n\t\tif (input.imm_u.range(19, 19) == \"1\")\n\t\t\t// Extend with 1s\n\t\t\ttmp_sigext_imm_i = (sc_bv<20>(\"11111111111111111111\"), (sc_bv<12>)input.imm_u.range(19, 8));\n\t\telse\n\t\t\t// Extend with 0s\n\t\t\ttmp_sigext_imm_i = (sc_bv<20>(\"00000000000000000000\"), (sc_bv<12>)input.imm_u.range(19, 8));\n\n\t\t// Zero-fill the immediate operand for U-type instructions.\n\t\tsc_bv<XLEN> tmp_zerofill_imm_u = ((sc_bv<20>)input.imm_u.range(19, 0), sc_bv<12>(\"000000000000\"));\n\n\t\t// ALU 2nd operand multiplexing based on ALUSRC signal.\n\t\tsc_bv<XLEN> tmp_rs2 = (sc_bv<XLEN>)0;\n\n\t\tif (input.alu_src == (sc_bv<ALUSRC_SIZE>)ALUSRC_RS2) {\n\t\t\ttmp_rs2 = input.rs2;\n\t\t} else if (input.alu_src == (sc_bv<ALUSRC_SIZE>)ALUSRC_IMM_I) {\n\t\t\ttmp_rs2 = tmp_sigext_imm_i;\n\t\t} else if (input.alu_src == (sc_bv<ALUSRC_SIZE>)ALUSRC_IMM_S) {\n\t\t\t// reconstructs imm_s from imm_u and rd\n\t\t\tsc_bv<12> imm_s = (sc_bv<7>(input.imm_u.range(19, 13)), input.dest_reg);\n\t\t\ttmp_rs2 = sign_extend_imm_s(imm_s);\n\t\t} else {\n\t\t\t// ALUSRC_IMM_U\n\t\t\ttmp_rs2 = tmp_zerofill_imm_u;\n\t\t}\n\n\t\t// ALU body\n\t\tswitch(sc_uint<ALUOP_SIZE>(input.alu_op)) {\n\t\tcase ALUOP_ADD: // ADD, ADDI, SB, SH, SW, LB, LH, LW, LBU, LHU.\n\t\t\toutput.alu_res = sc_bv<XLEN>((sc_int<XLEN>)input.rs1 + (sc_int<XLEN>)tmp_rs2);\n\t\t\tbreak;\n\t\tcase ALUOP_SLT: // SLT, SLTI\n\t\t\tif (sc_int<XLEN>(input.rs1) < sc_int<XLEN>(tmp_rs2))\n\t\t\t\toutput.alu_res = (sc_bv<XLEN>)1;\n\t\t\telse\n\t\t\t\toutput.alu_res = (sc_bv<XLEN>)0;\n\t\t\tbreak;\n\t\tcase ALUOP_SLTU: // SLTU, SLTIU\n\t\t\tif (sc_uint<XLEN>(input.rs1) < sc_uint<XLEN>(tmp_rs2))\n\t\t\t\toutput.alu_res = (sc_bv<XLEN>)1;\n\t\t\telse\n\t\t\t\toutput.alu_res = (sc_bv<XLEN>)0;\n\t\t\tbreak;\n\t\tcase ALUOP_XOR: // XOR, XORI\n\t\t\toutput.alu_res = input.rs1 ^ tmp_rs2;\n\t\t\tbreak;\n\t\tcase ALUOP_OR: // OR, ORI\n\t\t\toutput.alu_res = input.rs1 | tmp_rs2;\n\t\t\tbreak;\n\t\tcase ALUOP_AND: // AND, ANDI\n\t\t\toutput.alu_res = input.rs1 & tmp_rs2;\n\t\t\tbreak;\n\t\tcase ALUOP_SLL: // SLL\n\t\t\toutput.alu_res = sc_uint<XLEN>(input.rs1) << sc_uint<SHAMT>((sc_bv<SHAMT>)tmp_rs2.range(4, 0));\n\t\t\tbreak;\n\t\tcase ALUOP_SRL: // SRL\n\t\t\toutput.alu_res = sc_uint<XLEN>(input.rs1) >> sc_uint<SHAMT>((sc_bv<SHAMT>)tmp_rs2.range(4, 0));\n\t\t\tbreak;\n\t\tcase ALUOP_SRA: // SRA\n\t\t\t// >> is arith right sh. for sc_int operand\n\t\t\toutput.alu_res = sc_int<XLEN>(input.rs1) >> sc_uint<SHAMT>((sc_bv<SHAMT>)tmp_rs2.range(4, 0));\n\t\t\tbreak;\n\t\tcase ALUOP_SUB: // SUB\n\t\t\toutput.alu_res = sc_bv<XLEN>((sc_int<XLEN>)input.rs1 - (sc_int<XLEN>)tmp_rs2);\n\t\t\tbreak;\n\t\tcase ALUOP_SLLI: // SLLI\n\t\t\toutput.alu_res = sc_uint<XLEN>(input.rs1) << sc_uint<SHAMT>((sc_bv<SHAMT>)tmp_rs2.range(24, 20));\n\t\t\tbreak;\n\t\tcase ALUOP_SRLI: // SRLI\n\t\t\toutput.alu_res = sc_uint<XLEN>(input.rs1) >> sc_uint<SHAMT>((sc_bv<SHAMT>)tmp_rs2.range(24, 20));\n\t\t\tbreak;\n\t\tcase ALUOP_SRAI: // SRAI\n\t\t\t// >> is arith right sh. for sc_int operand\n\t\t\toutput.alu_res = sc_int<XLEN>(input.rs1) >> sc_uint<SHAMT>((sc_bv<SHAMT>)tmp_rs2.range(24, 20));\n\t\t\tbreak;\n\t\tcase ALUOP_LUI: // LUI\n\t\t\t// zerofill_imm_u\n\t\t\toutput.alu_res = tmp_rs2;\n\t\t\tbreak;\n\t\tcase ALUOP_AUIPC: // AUIPC\n\t\t\t// zerofill_imm_u + pc\n\t\t\toutput.alu_res = sc_bv<XLEN>((sc_int<XLEN>)tmp_rs2 + (sc_int<XLEN>)input.pc);\n\t\t\tbreak;\n\t\tcase ALUOP_JAL: // JAL, JALR\n\t\t\t// link register update\n\t\t\toutput.alu_res = sc_bv<XLEN>((sc_int<XLEN>)input.pc + 4);\n\t\t\tbreak;\n#ifdef MUL32\n\t\tcase ALUOP_MUL: // MUL: signed * signed, return lower 32 bits\n\t\t\toutput.alu_res = (sc_int<XLEN>)input.rs1 * (sc_int<XLEN>)tmp_rs2;;\n\t\t\tbreak;\n#endif\n#ifdef MUL64\n\t\tcase ALUOP_MULH: // MULH: signed * signed, return upper 32 bits\n", "right_context": "\t\t\toutput.alu_res = sc_bv<XLEN*2>(sc_int<XLEN*2>(tmp_mul_res)).range((XLEN*2)-1, XLEN);\n\t\t\tbreak;\n#endif\n#ifdef DIV\n\t\tcase ALUOP_DIV: // DIV calls div_func\n\t\t\tdiv_res = div_func((sc_int<XLEN>)input.rs1, (sc_int<XLEN>)tmp_rs2);\n\t\t\toutput.alu_res = (sc_bv<XLEN>)div_res.quotient;\n\t\t\tbreak;\n\t\tcase ALUOP_DIVU: // DIVU calls udiv_func\n\t\t\tu_div_res = udiv_func((sc_uint<XLEN>)input.rs1, (sc_uint<XLEN>)tmp_rs2);\n\t\t\toutput.alu_res = (sc_bv<XLEN>)u_div_res.quotient;\n\t\t\tbreak;\n#endif\n#ifdef REM\n\t\tcase ALUOP_REM: // REM calls div_func\n\t\t\tdiv_res = div_func((sc_int<XLEN>)input.rs1, (sc_int<XLEN>)tmp_rs2);\n\t\t\toutput.alu_res = (sc_bv<XLEN>)div_res.remainder;\n\t\t\tbreak;\n\t\tcase ALUOP_REMU: // REMU calls udiv_func\n\t\t\tu_div_res = udiv_func((sc_uint<XLEN>)input.rs1, (sc_uint<XLEN>)tmp_rs2);\n\t\t\toutput.alu_res = (sc_bv<XLEN>)u_div_res.remainder;\n\t\t\tbreak;\n#endif\n#ifdef CSR_LOGIC\n\t\t\t// All CSRx instructions exploit imm_u[19:8] to get the csr address.\n\t\t\t// This avoids having 12 more bits on the FEDEC-EXE Flex Channel.\n\t\t\t// The same goes for imm_u[7:3] i.e. zimm for the 3 CSRxI instructions.\n\t\tcase ALUOP_CSRRW: // CSRRW\n\t\t\tcsr_index = get_csr_index(input.imm_u.range(19, 8));\n\t\t\toutput.alu_res = csr[csr_index];\n                        set_csr_value(csr_index, input.rs1, CSR_OP_WR, input.imm_u.range(19, 18));\n\t\t\tbreak;\n\t\tcase ALUOP_CSRRS: // CSRRS\n\t\t\tcsr_index = get_csr_index(input.imm_u.range(19, 8));\n\t\t\toutput.alu_res = csr[csr_index];\n                        set_csr_value(csr_index, input.rs1, CSR_OP_SET, input.imm_u.range(19, 18));\n\t\t\tbreak;\n\t\tcase ALUOP_CSRRC: // CSRRC\n\t\t\tcsr_index = get_csr_index(input.imm_u.range(19, 8));\n\t\t\toutput.alu_res = csr[csr_index];\n                        set_csr_value(csr_index, input.rs1, CSR_OP_CLR, input.imm_u.range(19, 18));\n\t\t\tbreak;\n\t\tcase ALUOP_CSRRWI: // CSRRWI\n\t\t\tcsr_index = get_csr_index(input.imm_u.range(19, 8));\n\t\t\toutput.alu_res = csr[csr_index];\n                        set_csr_value(csr_index, input.imm_u.range(7, 3), CSR_OP_WR, input.imm_u.range(19, 18));\n\t\t\tbreak;\n\t\tcase ALUOP_CSRRSI: // CSRRSI\n\t\t\tcsr_index = get_csr_index(input.imm_u.range(19, 8));\n\t\t\toutput.alu_res = csr[csr_index];\n                        set_csr_value(csr_index, input.imm_u.range(7, 3), CSR_OP_SET, input.imm_u.range(19, 18));\n\t\t\tbreak;\n\t\tcase ALUOP_CSRRCI: // CSRRCI\n\t\t\tcsr_index = get_csr_index(input.imm_u.range(19, 8));\n\t\t\toutput.alu_res = csr[csr_index];\n                        set_csr_value(csr_index, input.imm_u.range(7, 3), CSR_OP_CLR, input.imm_u.range(19, 18));\n\t\t\tbreak;\n#endif\n\t\tdefault: // ALUOP_NULL (do nothing)\n\t\t\toutput.alu_res = (sc_bv<XLEN>)0;\n\t\t\tbreak;\n\t\t}\n\n\n\t\t// Forward\n\t\treg_forward_t forward;\n\t\tforward.regfile_data = output.alu_res;\n\t\tforward.tag = output.tag;\n\t\tif (input.ld != NO_LOAD || input.st != NO_STORE)\n\t\t\tforward.ldst = true;\n\t\telse\n\t\t\tforward.ldst = false;\n\n\t\tfwd_exe.write(forward);\n\n                if (!nop)\n                    csr[MINSTRET_I]++;\n\n\t\t// Put\n\t\tdout.put(output);\n\t\twait();\n\t}\n}\n\n/* Support functions */\n\n// Sign extend immS.\nsc_bv<XLEN> execute::sign_extend_imm_s(sc_bv<12> imm)\n{\n\tif (imm.range(11, 11) == \"1\") // Extend with 1s\n\t\treturn (sc_bv<20>(\"11111111111111111111\"), imm);\n\telse // Extend with 0s\n\t\treturn (sc_bv<20>(\"00000000000000000000\"), imm);\n}\n\n\n#ifdef CSR_LOGIC\n// Zero extends the zimm immediate field of CSRRWI, CSRRSI, CSRRCI\nsc_bv<XLEN> execute::zero_ext_zimm(sc_bv<ZIMM_SIZE> zimm)\n{\n\treturn (\"000000000000000000000000000\", zimm);\n}\n\n// Return index given a csr address.\nsc_uint<CSR_IDX_LEN> execute::get_csr_index(sc_bv<CSR_ADDR> csr_addr)\n{\n\tswitch ((sc_uint<CSR_ADDR>)csr_addr) {\n        case USTATUS_A:\n            return USTATUS_I;\n        case MSTATUS_A:\n            return MSTATUS_I;\n        case MISA_A:\n            return MISA_I;\n        case MTVECT_A:\n            return MTVECT_I;\n        case MEPC_A:\n            return MEPC_I;\n        case MCAUSE_A:\n            return MCAUSE_I;\n        case MCYCLE_A:\n            return MCYCLE_I;\n        case MARCHID_A:\n            return MARCHID_I;\n        case MIMPID_A:\n            return MIMPID_I;\n        case MINSTRET_A:\n            return MINSTRET_I;\n        case MHARTID_A:\n            return MHARTID_I;\n\tdefault:\n\t\treturn 6; // TODO: this is not ideal. I default unsupported CSRs to MARCHID as it's not a critical register.\n\t}\n}\n\n// Set value of csr[csr_addr]\n// TODO: respect unwritable fields, see manual for each individual implemented CSR.\n// TODO: for now any bits of every register are fully readable/writeable.\n// TODO: This must be changed in future implementations.\nvoid execute::set_csr_value(sc_uint<CSR_IDX_LEN> csr_index, sc_bv<XLEN> rs1, sc_uint<LOG2_CSR_OP_NUM> operation, sc_bv<2> rw_permission)\n{\n    if (rw_permission != \"11\")\n\tswitch(operation) {\n        case CSR_OP_WR:\n            csr[csr_index] = rs1;\n            break;\n        case CSR_OP_SET:\n            csr[csr_index] |= (sc_uint<XLEN>)rs1;\n            break;\n        case CSR_OP_CLR:\n            csr[csr_index] &= ~((sc_uint<XLEN>)rs1);\n            break;\n        default:\n            break;\n\t}\n}\n#endif\n", "groundtruth": "\t\t\ttmp_mul_res = input.rs1.to_int() * tmp_rs2.to_int();\n\t\t\toutput.alu_res = sc_bv<XLEN*2>(sc_int<XLEN*2>(tmp_mul_res)).range((XLEN*2)-1, XLEN);\n\t\t\tbreak;\n\t\tcase ALUOP_MULHSU: // MULHSU: signed * unsigned, return upper 32 bits\n\t\t\ttmp_mul_res = input.rs1.to_int() * tmp_rs2.to_uint();\n", "crossfile_context": "", "source_line": 243, "groundtruth_line_count": 5, "why": "design path, behavioral compute logic, has related tests", "related_tests": ["hl5/soft/test.c", "hl5/tb/colormod.hpp", "hl5/tb/sc_main.cpp", "hl5/tb/system.cpp", "hl5/tb/system.hpp", "hl5/tb/tb.cpp", "hl5/tb/tb.hpp"], "local_folder": "execute", "local_file": "execute/execute.cpp", "local_original_file": "execute/execute_original.cpp", "selection_score": 57}
{"task_id": "hl5", "path": "hl5/src/fedec.cpp", "left_context": "/* Copyright 2017 Columbia University, SLD Group */\n\n//\n// fedec.cpp - Robert Margelli\n// Implementation of the fedec stage ie combined fetch and decode stages.\n//\n\n#include \"fedec.hpp\"\n\n#ifndef STRATUS_HLS\n#include <colormod.hpp> // namespace Color\n#endif\n\n// #define MAIN_START_O2 0x10074\n#define SENTINEL_INIT (1 << (TAG_WIDTH - 1))\n\nvoid fedec::fedec_th(void)\n{\nFEDEC_RST:\n\t{\n\t\tPROTO_FEDEC_RST;\n\t\tdout.reset_put();\n\t\tfeed_from_wb.reset_get();\n\n\t\t// Init. sentinel flags to zero.\n\n\t\tfor(int i = 0; i < REG_NUM; i++) {\n\t\t\tHLS_UNROLL_LOOP(ON);\n\t\t\tsentinel[i] = SENTINEL_INIT;\n\t\t}\n\n\t\t// Program has not completed\n\t\tprogram_end.write(false);\n\n\t\t// Reset instruction counters\n\t\ticount.write(0); // any\n\t\tj_icount.write(0); // jump\n\t\tb_icount.write(0); // branch\n\t\tm_icount.write(0); // load, store\n\t\to_icount.write(0); // other\n\n\t\tposition = 0;\n\t\ttrap = \"0\";\n\t\ttrap_cause = NULL_CAUSE;\n\t\tfreeze = false;\n\t\ttag = 0;\n\n\n\t\t// TODO removeme\n\t\t// main_start.write(false);\n\t\t// main_end.write(false);\n\n", "right_context": "\n\t\t//  Init. pc to START_ADDRESS - 4 as on first fetch it will be incremented by\n\t\t//  4, thus fetching instruction at address 0\n\t\tpc = entry_point.read();\n\t}\n\nFEDEC_BODY:\n\twhile(true) {\n\t\tPROTO_FEDEC_BODY;\n\n\t\t// --- Fetch\n\t\tif (!freeze) {\n\t\t\t// Increment instruction counter\n\t\t\ticount.write(icount.read() + 1);\n\n\t\t\tif (self_feed.jump == \"1\")\n\t\t\t\tpc = (sc_uint<PC_LEN>)self_feed.jump_address;\n\t\t\telse if (self_feed.branch == \"1\")\n\t\t\t\tpc = (sc_uint<PC_LEN>)self_feed.branch_address;\n\t\t\telse\n\t\t\t\tpc = sc_uint<PC_LEN>(pc + 4);\n\t\t\ttag = (tag + 1) % (1 << (TAG_WIDTH - 1));\n\t\t}\n\n\t\toutput.pc = pc;\n\t\tunsigned int aligned_pc = pc >> 2;\n\n\t\twait();\n\t\tunsigned int imem_data = imem[aligned_pc];\n\t\tinsn = imem_data;\n\n\t\t// Increment some instruction counters\n\t\tif (!freeze) {\n\t\t\tsc_uint<OPCODE_SIZE> opcode = sc_uint<OPCODE_SIZE>(sc_bv<OPCODE_SIZE>(insn.range(6, 2)));\n\n\t\t\tif (opcode == OPC_LW || opcode == OPC_SW)\n\t\t\t\t// Increment memory instruction counter\n\t\t\t\tm_icount.write(m_icount.read() + 1);\n\t\t\telse if (opcode == OPC_JAL || opcode == OPC_JALR)\n\t\t\t\t// Increment jump instruction counter\n\t\t\t\tj_icount.write(j_icount.read() + 1);\n\t\t\telse if (opcode == OPC_BEQ)\n\t\t\t\t// Increment branch instruction counter\n\t\t\t\tb_icount.write(b_icount.read() + 1);\n\t\t\telse\n\t\t\t\t// Increment other instruction counter\n\t\t\t\to_icount.write(o_icount.read() + 1);\n\t\t}\n\n\t\tfreeze = false; // Un-freeze fetching\n\n\t\tif (insn == 0x0000006f) {\n\t\t\t// jump to yourself (end of program).\n\t\t\tprogram_end.write(true);\n\t\t}\n\t\t// --- ENDOF Fetch\n\n\t\t// --- Decode\n\t\tif (position > 1) // Synchronize with WB stage at startup.\n\t\t\tfeedinput = feed_from_wb.get(); // Get from writeback.\n\t\telse\n\t\t\tposition++;\n\n\t\t// *** Register file write.\n\t\tif (feedinput.regwrite == \"1\" && feedinput.regfile_address != \"00000\") { // Actual writeback.\n\t\t\tregfile[sc_uint<REG_ADDR>(feedinput.regfile_address)] = feedinput.regfile_data; // Overwrite register.\n\t\t\tif (feedinput.tag == sentinel[sc_uint<REG_ADDR>(feedinput.regfile_address)])\n\t\t\t\tsentinel[sc_uint<REG_ADDR>(feedinput.regfile_address)] = SENTINEL_INIT; // Reset sentinel flag.\n\t\t}\n\n\t\t// *** Register file read.\n\t\tbool forward_success_rs1 = false;\n\t\tbool forward_success_rs2 = false;\n\t\tsc_uint<REG_ADDR> rs1_addr(sc_bv<REG_ADDR>(insn.range(19, 15)));\n\t\tsc_uint<REG_ADDR> rs2_addr(sc_bv<REG_ADDR>(insn.range(24, 20)));\n\t\tbool rs1_raw = false;\n\t\tbool rs2_raw = false;\n\t\treg_forward_t fwd = fwd_exe.read();\n#ifdef FWD_ENABLE\n\t\tif (!fwd.ldst && fwd.tag == sentinel[rs1_addr] && fwd.tag != SENTINEL_INIT) {\n\t\t\tforward_success_rs1 = true;\n\t\t\toutput.rs1 = fwd.regfile_data;\n\t\t} else {\n#endif\n\t\t\toutput.rs1 = regfile[rs1_addr];\n#ifdef FWD_ENABLE\n\t\t}\n\t\tif (!fwd.ldst && fwd.tag == sentinel[rs2_addr] && fwd.tag != SENTINEL_INIT) {\n\t\t\tforward_success_rs2 = true;\n\t\t\toutput.rs2 = fwd.regfile_data;\n\t\t} else {\n#endif\n\t\t\toutput.rs2 = regfile[rs2_addr];\n#ifdef FWD_ENABLE\n\t\t}\n#endif\n\n\t\t// *** Feedback to fetch data computation and put() section.\n\t\t// -- Address sign extensions.\n\t\tsc_bv<21> immjal_tmp = ((sc_bv<1>)insn.range(31, 31), (sc_bv<8>)insn.range(19, 12), (sc_bv<1>)insn.range(20, 20), (sc_bv<10>)insn.range(30, 21), (sc_bv<1>)(0));\n\t\tsc_bv<13> immbranch_tmp = ((sc_bv<1>)insn.range(31, 31), (sc_bv<1>)insn.range(7, 7), (sc_bv<6>)insn.range(30, 25), (sc_bv<4>)insn.range(11, 8), (sc_bv<1>)(0));\n\t\tself_feed.branch_address = sc_bv<PC_LEN>((sc_int<PC_LEN>)sign_extend_branch(immbranch_tmp) + (sc_int<PC_LEN>)pc);\n\n\t\t// -- Jump.\n\t\tif (insn.range(6, 2) == OPC_JAL) {\n\t\t\tself_feed.jump_address = sc_bv<PC_LEN>((sc_int<PC_LEN>)sign_extend_jump(immjal_tmp) + (sc_int<PC_LEN>)pc);\n\t\t\tself_feed.jump = \"1\";\n\n\t\t\t// TODO remove me\n// \t\t\tif (MAIN_START_O2 == self_feed.jump_address) {\n// \t\t\t\tmain_start.write(true);\n// \t\t\t\tmain_end.write(false);\n// \t\t\t\treturn_address = pc + 4;\n// #ifdef VERBOSE\n// #ifndef STRATUS_HLS\n\n// \t\t\t\tstd::cout << \"Jump to main; return address is \" << std::hex << return_address << std::dec << std::endl;\n// #endif\n// #endif\n\n// \t\t\t}\n\t\t}\n\t\telse if (insn.range(6, 2) == OPC_JALR) {\n\t\t\tsc_bv<PC_LEN> extended;\n\t\t\tif (insn[31] == 0)\n\t\t\t\textended = (\"00000000000000000000000000000000\");\n\t\t\telse \n\t\t\t\textended = (\"11111111111111111111111111111111\");\n\n\t\t\textended.range(11, 0) = insn.range(31, 20);\n\t\t        self_feed.jump_address = sc_bv<PC_LEN>((sc_int<PC_LEN>) extended + (sc_int<PC_LEN>) output.rs1);\n\t\t\tself_feed.jump_address.range(0, 0) = \"0\";\n\t\t\tself_feed.jump = \"1\";\n\n\t\t\t// TODO remove me\n// \t\t\tif (return_address == self_feed.jump_address) {\n// \t\t\t\tmain_end.write(true);\n// \t\t\t\tmain_start.write(false);\n// #ifdef VERBOSE\n// #ifndef STRATUS_HLS\n\n// \t\t\t\tstd::cout << \"Returning from main from address \" << std::hex << pc << std::dec << std::endl;\n// #endif\n// #endif\n\n// \t\t\t}\n\t\t}\n\t\telse{\n\t\t\tself_feed.jump = \"0\";\n\t\t}\n\n\t\t// -- Branch circuitry.\n\t\tself_feed.branch = \"0\";\n\t\tif (insn.range(6, 2) == OPC_BEQ) {  // BEQ,BNE, BLT, BGE, BLTU, BGEU\n\t\t\tswitch(sc_uint<3>(sc_bv<3>(insn.range(14, 12)))) {\n\t\t\tcase FUNCT3_BEQ:\n\t\t\t\tif (output.rs1 == output.rs2)\n\t\t\t\t\tself_feed.branch = \"1\";  // BEQ taken.\n\t\t\t\tbreak;\n\t\t\tcase FUNCT3_BNE:\n\t\t\t\tif (output.rs1 != output.rs2)\n\t\t\t\t\tself_feed.branch = \"1\";  // BNE taken.\n\t\t\t\tbreak;\n\t\t\tcase FUNCT3_BLT:\n\t\t\t\tif ((sc_int<XLEN>)output.rs1 < (sc_int<XLEN>)output.rs2)\n\t\t\t\t\tself_feed.branch = \"1\";  // BLT taken.\n\t\t\t\tbreak;\n\t\t\tcase FUNCT3_BGE:\n\t\t\t\tif ((sc_int<XLEN>)output.rs1 >= (sc_int<XLEN>)output.rs2)\n\t\t\t\t\tself_feed.branch = \"1\";  // BGE taken.\n\t\t\t\tbreak;\n\t\t\tcase FUNCT3_BLTU:\n\t\t\t\tif ((sc_uint<XLEN>)output.rs1 < (sc_uint<XLEN>)output.rs2)\n\t\t\t\t\tself_feed.branch = \"1\";  // BLTU taken.\n\t\t\t\tbreak;\n\t\t\tcase FUNCT3_BGEU:\n\t\t\t\tif ((sc_uint<XLEN>)output.rs1 >= (sc_uint<XLEN>)output.rs2)\n\t\t\t\t\tself_feed.branch = \"1\";  // BGEU taken.\n\t\t\t\tbreak;\n\t\t\tdefault:\n\t\t\t\tself_feed.branch = \"0\";  // default to not taken.\n\t\t\t\tbreak;\n\t\t\t}\n\t\t}\n\t\t// -- All data for feedback path to fetch is ready now. Do put(): in this version it saved data in self_feed.\n\t\t// *** END of feedback to fetch data computation and put() section.\n\n\t\t// *** Propagations: rd, immediates sign extensions.\n\t\toutput.dest_reg = insn.range(11, 7);                            // RD field of insn.\n\t\toutput.imm_u = insn.range(31, 12);                              // This field is then used in the execute stage not only as immU field but to obtain several subfields used by non U-type instructions.\n\t\t// *** END of RD propagation and immediates sign extensions.\n\n\t\t// *** Control word generation.\n\t\tswitch(sc_uint<OPCODE_SIZE>(sc_bv<OPCODE_SIZE>(insn.range(6, 2)))) { // Opcode's 2 LSBs have been trimmed to save area.\n\n\t\tcase OPC_LUI:\n\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_LUI;\n\t\t\toutput.alu_src  = (sc_bv<ALUSRC_SIZE>)ALUSRC_IMM_U;\n\t\t\toutput.regwrite = \"1\";\n\t\t\toutput.ld       = NO_LOAD;\n\t\t\toutput.st       = NO_STORE;\n\t\t\toutput.memtoreg = \"0\";\n\t\t\ttrap = \"0\";\n\t\t\ttrap_cause = NULL_CAUSE;\n\t\t\tbreak;\n\n\t\tcase OPC_AUIPC:\n\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_AUIPC;\n\t\t\toutput.alu_src  = (sc_bv<ALUSRC_SIZE>)ALUSRC_IMM_U;\n\t\t\toutput.regwrite = \"1\";\n\t\t\toutput.ld       = NO_LOAD;\n\t\t\toutput.st       = NO_STORE;\n\t\t\toutput.memtoreg = \"0\";\n\t\t\ttrap = \"0\";\n\t\t\ttrap_cause = NULL_CAUSE;\n\t\t\tbreak;\n\n\t\tcase OPC_JAL:\n\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_JAL;\n\t\t\toutput.alu_src  = (sc_bv<ALUSRC_SIZE>)ALUSRC_RS2;   // Actually does not use RS2 as it performs \"rd = pc + 4\"\n\t\t\toutput.regwrite = \"1\";\n\t\t\toutput.ld       = NO_LOAD;\n\t\t\toutput.st       = NO_STORE;\n\t\t\toutput.memtoreg = \"0\";\n\t\t\ttrap = \"0\";\n\t\t\ttrap_cause = NULL_CAUSE;\n\t\t\tbreak;\n\n\t\tcase OPC_JALR:  // same as JAL, could optimize\n\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_JALR;\n\t\t\toutput.alu_src  = (sc_bv<ALUSRC_SIZE>)ALUSRC_RS2;   // Actually does not use RS2 as it performs \"rd = pc + 4\"\n\t\t\toutput.regwrite = \"1\";\n\t\t\toutput.ld       = NO_LOAD;\n\t\t\toutput.st       = NO_STORE;\n\t\t\toutput.memtoreg = \"0\";\n\t\t\ttrap = \"0\";\n\t\t\ttrap_cause = NULL_CAUSE;\n\t\t\trs1_raw = true;\n\t\t\tbreak;\n\n\t\tcase OPC_BEQ: // Branch instructions: BEQ, BNE, BLT, BGE, BLTU, BGEU\n\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_NULL;\n\t\t\toutput.alu_src  = (sc_bv<ALUSRC_SIZE>)ALUSRC_RS2;\n\t\t\toutput.regwrite = \"0\";\n\t\t\toutput.ld       = NO_LOAD;\n\t\t\toutput.st       = NO_STORE;\n\t\t\toutput.memtoreg = \"0\";\n\t\t\ttrap = \"0\";\n\t\t\ttrap_cause = NULL_CAUSE;\n\t\t\trs1_raw = true;\n\t\t\trs2_raw = true;\n\t\t\tbreak;\n\n\t\tcase OPC_LW:\n\t\t\tswitch(sc_uint<3>(sc_bv<3>(insn.range(14, 12)))) {\n\t\t\tcase FUNCT3_LB:\n\t\t\t\toutput.ld       = LB_LOAD;\n\t\t\t\tbreak;\n\t\t\tcase FUNCT3_LH:\n\t\t\t\toutput.ld       = LH_LOAD;\n\t\t\t\tbreak;\n\t\t\tcase FUNCT3_LW:\n\t\t\t\toutput.ld       = LW_LOAD;\n\t\t\t\tbreak;\n\t\t\tcase FUNCT3_LBU:\n\t\t\t\toutput.ld       = LBU_LOAD;\n\t\t\t\tbreak;\n\t\t\tcase FUNCT3_LHU:\n\t\t\t\toutput.ld       = LHU_LOAD;\n\t\t\t\tbreak;\n\t\t\tdefault:\n\t\t\t\toutput.ld       = NO_LOAD;\n#ifndef STRATUS_HLS\n\t\t\t\tSC_REPORT_ERROR(sc_object::name(), \"Unimplemented LOAD instruction\");\n#endif\n\t\t\t\tbreak;\n\t\t\t}\n\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_ADD;\n\t\t\toutput.alu_src  = (sc_bv<ALUSRC_SIZE>)ALUSRC_IMM_I;\n\t\t\toutput.regwrite = \"1\";\n\t\t\toutput.st       = NO_STORE;\n\t\t\toutput.memtoreg = \"1\";\n\t\t\ttrap = \"0\";\n\t\t\ttrap_cause = NULL_CAUSE;\n\t\t\trs1_raw = true; // Base address\n\t\t\tbreak;\n\n\t\tcase OPC_SW:\n\t\t\tswitch(sc_uint<3>(sc_bv<3>(insn.range(14, 12)))) {\n\t\t\tcase FUNCT3_SB:\n\t\t\t\toutput.st       = SB_STORE;\n\t\t\t\tbreak;\n\t\t\tcase FUNCT3_SH:\n\t\t\t\toutput.st       = SH_STORE;\n\t\t\t\tbreak;\n\t\t\tcase FUNCT3_SW:\n\t\t\t\toutput.st       = SW_STORE;\n\t\t\t\tbreak;\n\t\t\tdefault:\n\t\t\t\toutput.st       = NO_STORE;\n#ifndef STRATUS_HLS\n\t\t\t\tSC_REPORT_ERROR(sc_object::name(), \"Unimplemented STORE instruction\");\n#endif\n\t\t\t\tbreak;\n\t\t\t}\n\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_ADD;\n\t\t\toutput.alu_src  = (sc_bv<ALUSRC_SIZE>)ALUSRC_IMM_S;\n\t\t\toutput.regwrite = \"0\";\n\t\t\toutput.ld       = NO_LOAD;\n\t\t\toutput.memtoreg = \"0\";\n\t\t\ttrap = \"0\";\n\t\t\ttrap_cause = NULL_CAUSE;\n\t\t\trs1_raw = true; // Base address\n\t\t\trs2_raw = true; // Input Data\n\t\t\tbreak;\n\n\t\tcase OPC_ADDI:  // OP-IMM instructions (arithmetic and logical operations on immediates): ADDI, SLTI, SLTIU, XORI, ORI, ANDI, SLLI, SRLI, SRAI\n\n\t\t\tif (sc_uint<7>(sc_bv<7>(insn.range(31, 25))) == FUNCT7_SRAI && sc_uint<3>(sc_bv<3>(insn.range(14, 12))) == FUNCT3_SRAI) {\n\t\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_SRAI;\n\t\t\t\toutput.alu_src  = (sc_bv<ALUSRC_SIZE>)ALUSRC_IMM_U;\n\t\t\t}\n\t\t\telse if (sc_uint<7>(sc_bv<7>(insn.range(31, 25))) == FUNCT7_SLLI && sc_uint<3>(sc_bv<3>(insn.range(14, 12))) == FUNCT3_SLLI) {\n\t\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_SLLI;\n\t\t\t\toutput.alu_src  = (sc_bv<ALUSRC_SIZE>)ALUSRC_IMM_U;\n\t\t\t}\n\t\t\telse if (sc_uint<7>(sc_bv<7>(insn.range(31, 25))) == FUNCT7_SRLI && sc_uint<3>(sc_bv<3>(insn.range(14, 12))) == FUNCT3_SRLI) {\n\t\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_SRLI;\n\t\t\t\toutput.alu_src  = (sc_bv<ALUSRC_SIZE>)ALUSRC_IMM_U;\n\t\t\t}\n\t\t\telse{\n\t\t\t\toutput.alu_src  = (sc_bv<ALUSRC_SIZE>)ALUSRC_IMM_I;\n\t\t\t\tswitch(sc_uint<3>(sc_bv<3>(insn.range(14, 12)))) {\n\t\t\t\tcase FUNCT3_ADDI:\n\t\t\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_ADDI;\n\t\t\t\t\tbreak;\n\t\t\t\tcase FUNCT3_SLTI:\n\t\t\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_SLTI;\n\t\t\t\t\tbreak;\n\t\t\t\tcase FUNCT3_SLTIU:\n\t\t\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_SLTIU;\n\t\t\t\t\tbreak;\n\t\t\t\tcase FUNCT3_XORI:\n\t\t\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_XORI;\n\t\t\t\t\tbreak;\n\t\t\t\tcase FUNCT3_ORI:\n\t\t\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_ORI;\n\t\t\t\t\tbreak;\n\t\t\t\tcase FUNCT3_ANDI:\n\t\t\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_ANDI;\n\t\t\t\t\tbreak;\n\t\t\t\tdefault:\n\t\t\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_NULL;\n#ifndef STRATUS_HLS\n\t\t\t\t\tSC_REPORT_ERROR(sc_object::name(), \"Unimplemented ALUOP_IMM instruction\");\n#endif\n\t\t\t\t\tbreak;\n\t\t\t\t}\n\t\t\t}\n\t\t\toutput.regwrite = \"1\";\n\t\t\toutput.ld       = NO_LOAD;\n\t\t\toutput.st       = NO_STORE;\n\t\t\toutput.memtoreg = \"0\";\n\t\t\ttrap = \"0\";\n\t\t\ttrap_cause = NULL_CAUSE;\n\t\t\trs1_raw = true;\n\t\t\tbreak;\n\n\t\tcase OPC_ADD: // R-type instructions: ADD, SLL, SLT, SLTU, XOR, SRL, OR, AND, SUB, SRA, MUL, MULH, MULHSU, MULHU, DIV, DIVU, REM, REMU.\n\t\t\toutput.alu_src  = (sc_bv<ALUSRC_SIZE>)ALUSRC_RS2;\n\t\t\toutput.regwrite = \"1\";\n\t\t\toutput.ld       = NO_LOAD;\n\t\t\toutput.st       = NO_STORE;\n\t\t\toutput.memtoreg = \"0\";\n\t\t\ttrap = \"0\";\n\t\t\ttrap_cause = NULL_CAUSE;\n\t\t\t// FUNCT7 switch discriminates between classes of R-type instructions.\n\t\t\tswitch(sc_uint<7>(sc_bv<7>(insn.range(31, 25)))) {\n\t\t\tcase FUNCT7_ADD:    // ADD, SLL, SLT, SLTU, XOR, SRL, OR, AND\n\t\t\t\tswitch(sc_uint<3>(sc_bv<3>(insn.range(14, 12)))) {\n\t\t\t\tcase FUNCT3_ADD:\n\t\t\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_ADD;\n\t\t\t\t\tbreak;\n\t\t\t\tcase FUNCT3_SLL:\n\t\t\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_SLL;\n\t\t\t\t\tbreak;\n\t\t\t\tcase FUNCT3_SLT:\n\t\t\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_SLT;\n\t\t\t\t\tbreak;\n\t\t\t\tcase FUNCT3_SLTU:\n\t\t\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_SLTU;\n\t\t\t\t\tbreak;\n\t\t\t\tcase FUNCT3_XOR:\n\t\t\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_XOR;\n\t\t\t\t\tbreak;\n\t\t\t\tcase FUNCT3_SRL:\n\t\t\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_SRL;\n\t\t\t\t\tbreak;\n\t\t\t\tcase FUNCT3_OR:\n\t\t\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_OR;\n\t\t\t\t\tbreak;\n\t\t\t\tcase FUNCT3_AND:\n\t\t\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_AND;\n\t\t\t\t\tbreak;\n\t\t\t\tdefault:\n\t\t\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_NULL;\n#ifndef STRATUS_HLS\n\t\t\t\t\tSC_REPORT_ERROR(sc_object::name(), \"Unimplemented ALUOP_ADD instruction\");\n#endif\n\t\t\t\t\tbreak;\n\t\t\t\t}\n\t\t\t\tbreak;\n\t\t\tcase FUNCT7_SUB:    // SUB, SRA\n\t\t\t\tswitch(sc_uint<3>(sc_bv<3>(insn.range(14, 12)))) {\n\t\t\t\tcase FUNCT3_SUB:\n\t\t\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_SUB;\n\t\t\t\t\tbreak;\n\t\t\t\tcase FUNCT3_SRA:\n\t\t\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_SRA;\n\t\t\t\t\tbreak;\n\t\t\t\tdefault:\n\t\t\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_NULL;\n#ifndef STRATUS_HLS\n\t\t\t\t\tSC_REPORT_ERROR(sc_object::name(), \"Unimplemented ALUOP_SUB instruction\");\n#endif\n\t\t\t\t\tbreak;\n\t\t\t\t}\n\t\t\t\tbreak;\n#if defined(MUL32) || defined(MUL64) || defined(DIV) || defined(REM)\n\t\t\tcase FUNCT7_MUL:    // MUL, MULH, MULHSU, MULHU, DIV, DIVU, REM, REMU\n\t\t\t\tswitch(sc_uint<3>(sc_bv<3>(insn.range(14, 12)))) {\n\t\t\t\tcase FUNCT3_MUL:\n\t\t\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_MUL;\n\t\t\t\t\tbreak;\n\t\t\t\tcase FUNCT3_MULH:\n\t\t\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_MULH;\n\t\t\t\t\tbreak;\n\t\t\t\tcase FUNCT3_MULHSU:\n\t\t\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_MULHSU;\n\t\t\t\t\tbreak;\n\t\t\t\tcase FUNCT3_MULHU:\n\t\t\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_MULHU;\n\t\t\t\t\tbreak;\n\t\t\t\tcase FUNCT3_DIV:\n\t\t\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_DIV;\n\t\t\t\t\tbreak;\n\t\t\t\tcase FUNCT3_DIVU:\n\t\t\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_DIVU;\n\t\t\t\t\tbreak;\n\t\t\t\tcase FUNCT3_REM:\n\t\t\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_REM;\n\t\t\t\t\tbreak;\n\t\t\t\tcase FUNCT3_REMU:\n\t\t\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_REMU;\n\t\t\t\t\tbreak;\n\t\t\t\tdefault:\n\t\t\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_NULL;\n#ifndef STRATUS_HLS\n\t\t\t\t\tSC_REPORT_ERROR(sc_object::name(), \"Unimplemented ALUOP_MUL instruction\");\n#endif\n\t\t\t\t\tbreak;\n\t\t\t\t}\n\t\t\t\tbreak;\n#endif\n\t\t\tdefault:\n\t\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_NULL;\n#ifndef STRATUS_HLS\n\t\t\t\tSC_REPORT_ERROR(sc_object::name(), \"Unimplemented ALUOP instruction\");\n#endif\n\t\t\t\tbreak;\n\t\t\t}\n\t\t\trs1_raw = true;\n\t\t\trs2_raw = true;\n\t\t\tbreak;\n\n#ifdef CSR_LOGIC\n\t\tcase OPC_SYSTEM:\n\t\t\toutput.alu_op   = (sc_bv<ALUOP_SIZE>)ALUOP_NULL;\n\t\t\toutput.alu_src  = (sc_bv<ALUSRC_SIZE>)ALUSRC_RS2;\n\t\t\toutput.ld       = NO_LOAD;\n\t\t\toutput.st       = NO_STORE;\n\t\t\toutput.memtoreg = \"0\";\n\t\t\toutput.regwrite = \"1\";\n\t\t\trs1_raw = true;\n\t\t\tswitch(sc_uint<3>(sc_bv<3>(insn.range(14, 12)))) {\n\t\t\tcase FUNCT3_EBREAK: // EBREAK, ECALL\n\t\t\t\toutput.regwrite = \"0\";\n\t\t\t\trs1_raw = false;\n\t\t\t\ttrap = \"1\";\n\t\t\t\toutput.alu_op = (sc_bv<ALUOP_SIZE>)ALUOP_CSRRWI;\n\t\t\t\toutput.imm_u.range(19, 8) = (sc_bv<CSR_ADDR>)MCAUSE_A;    // force the CSR address to MCAUSE's\n\t\t\t\tif (sc_bv<1>(insn.range(20, 20)) == (sc_bv<1>)FUNCT7_EBREAK) {   // Bit 20 discriminates b/n EBREAK and ECALL\n\t\t\t\t\t// EBREAK and ECALL leverage CSRRWI decoding to write into the MCAUSE register\n\t\t\t\t\t// but keep regwrite to \"0\" to prevent writeback\n\t\t\t\t\ttrap_cause = EBREAK_CAUSE;  // may be not necessary but is kept for future implementations\n\t\t\t\t\toutput.imm_u.range(7, 3) = (sc_bv<ZIMM_SIZE>)EBREAK_CAUSE;  // force the exception cause on the zimm field\n\t\t\t\t}\n\t\t\t\telse{  // FUNCT7_ECALL\n\t\t\t\t\ttrap_cause = ECALL_CAUSE;   // may be not necessary but is kept for future implementations\n\t\t\t\t\toutput.imm_u.range(7, 3) = (sc_bv<ZIMM_SIZE>)ECALL_CAUSE;   // force the exception cause on the zimm field\n\t\t\t\t}\n\t\t\t\tbreak;\n\t\t\tcase FUNCT3_CSRRW:\n\t\t\t\toutput.alu_op = (sc_bv<ALUOP_SIZE>)ALUOP_CSRRW;\n\t\t\t\ttrap = \"0\";\n\t\t\t\ttrap_cause = NULL_CAUSE;\n\t\t\t\tbreak;\n\t\t\tcase FUNCT3_CSRRS:\n\t\t\t\toutput.alu_op = (sc_bv<ALUOP_SIZE>)ALUOP_CSRRS;\n\t\t\t\ttrap = \"0\";\n\t\t\t\ttrap_cause = NULL_CAUSE;\n\t\t\t\tbreak;\n\t\t\tcase FUNCT3_CSRRC:\n\t\t\t\toutput.alu_op = (sc_bv<ALUOP_SIZE>)ALUOP_CSRRC;\n\t\t\t\ttrap = \"0\";\n\t\t\t\ttrap_cause = NULL_CAUSE;\n\t\t\t\tbreak;\n\t\t\tcase FUNCT3_CSRRWI:\n\t\t\t\toutput.alu_op = (sc_bv<ALUOP_SIZE>)ALUOP_CSRRWI;\n\t\t\t\toutput.regwrite = \"1\";\n\t\t\t\ttrap = \"0\";\n\t\t\t\ttrap_cause = NULL_CAUSE;\n\t\t\t\tbreak;\n\t\t\tcase FUNCT3_CSRRSI:\n\t\t\t\toutput.alu_op = (sc_bv<ALUOP_SIZE>)ALUOP_CSRRSI;\n\t\t\t\ttrap = \"0\";\n\t\t\t\ttrap_cause = NULL_CAUSE;\n\t\t\t\tbreak;\n\t\t\tcase FUNCT3_CSRRCI:\n\t\t\t\toutput.alu_op = (sc_bv<ALUOP_SIZE>)ALUOP_CSRRCI;\n\t\t\t\ttrap = \"0\";\n\t\t\t\ttrap_cause = NULL_CAUSE;\n\t\t\t\tbreak;\n\t\t\tdefault:\n\t\t\t\toutput.alu_op = (sc_bv<ALUOP_SIZE>)ALUOP_NULL;\n\t\t\t\ttrap = \"0\";\n\t\t\t\ttrap_cause = NULL_CAUSE;\n#ifndef STRATUS_HLS\n\t\t\t\tSC_REPORT_ERROR(sc_object::name(), \"Unimplemented SYSTEM instruction\");\n#endif\n\t\t\t\tbreak;\n\t\t\t}\n\t\t\tbreak;\n#endif  // --- End of System instructions decoding\n\n                default: // illegal instruction\n\t\t\toutput.alu_src  = (sc_bv<ALUSRC_SIZE>)ALUSRC_RS2;\n\t\t\toutput.regwrite = \"0\";\n\t\t\toutput.ld       = NO_LOAD;\n\t\t\toutput.st       = NO_STORE;\n\t\t\toutput.memtoreg = \"0\";\n\t\t\ttrap = \"1\";\n\t\t\ttrap_cause = ILL_INSN_CAUSE;\n\t\t\toutput.alu_op = (sc_bv<ALUOP_SIZE>)ALUOP_CSRRWI;\n\t\t\toutput.imm_u.range(19, 8) = (sc_bv<12>)MCAUSE_A;    // force the CSR address to MCAUSE's\n\t\t\toutput.imm_u.range(7, 3) = (sc_bv<5>)ILL_INSN_CAUSE;  // force the exception cause\n\t\t\tbreak;\n#ifndef STRATUS_HLS\n\t\t\tSC_REPORT_ERROR(sc_object::name(), \"Unimplemented instruction\");\n#endif\n\t\t} // --- END of OPCODE switch\n\t\t// *** END of control word generation.\n\n\t\t// *** Stall mechanism\n\t\tif ((sentinel[rs1_addr] != SENTINEL_INIT && rs1_raw && !forward_success_rs1) || // If RAW on RS1\n\t\t    (sentinel[rs2_addr] != SENTINEL_INIT && rs2_raw && !forward_success_rs2))   // If RAW on RS2\n\t\t\tfreeze = true;\n\n\n\t\tif (!freeze && output.regwrite == \"1\" && output.dest_reg != \"00000\")\n\t\t\tsentinel[sc_uint<REG_ADDR>(output.dest_reg)] = tag;   // Set corresponding sentinel flag.\n\n\t\tif (!freeze)\n\t\t\toutput.tag = tag;\n\t\telse\n\t\t\toutput.tag = SENTINEL_INIT;\n\n#ifdef VERBOSE\n\n#ifndef STRATUS_HLS\n\t\t\tColor::Modifier red(Color::FG_RED);\n\t\t\tColor::Modifier yellow(Color::FG_YELLOW);\n\t\t\tColor::Modifier green(Color::FG_GREEN);\n\t\t\tColor::Modifier def(Color::FG_DEFAULT);\n\n\t\t\tif (freeze)\n\t\t\t\tstd::cout << red;\n\t\t\telse if (self_feed.jump == \"1\" || self_feed.branch == \"1\")\n\t\t\t\tstd::cout << yellow;\n\t\t\tstd::cout << std::hex << std::right << \"PC[0x\" << std::setw(8)  << pc << \"] -> \" << insn << std::dec << \" -> \";\n\t\t\tstd::cout << def;\n\n\n\t\t\tif (rs1_raw)\n\t\t\t\tstd::cout << \" \" << yellow << std::right << std::setfill(' ') << std::setw(3) << rs1_addr << \" \" << def;\n\t\t\telse\n\t\t\t\tstd::cout << \" \" << std::right << std::setfill(' ') << std::setw(3) << rs1_addr << \" \";\n\t\t\tif (rs2_raw)\n\t\t\t\tstd::cout << yellow << std::right << std::setfill(' ') << std::setw(3) << rs2_addr << def << \" -> \";\n\t\t\telse\n\t\t\t\tstd::cout << std::right << std::setfill(' ') << std::setw(3) << rs2_addr << \" -> \";\n\t\t\tif (output.regwrite == \"1\" )\n\t\t\t\tstd::cout << yellow << std::right << std::setfill(' ') << std::setw(3) << output.dest_reg.to_uint() << def;\n\t\t\telse\n\t\t\t\tstd::cout << std::right << std::setfill(' ') << std::setw(3) << output.dest_reg.to_uint();\n#endif\n\n\n#ifndef STRATUS_HLS\n\t\t\tif (forward_success_rs1 || forward_success_rs2)\n\t\t\t\tstd::cout << green;\n\t\t\tstd::cout << \"  **REGFILE** \";\n\t\t\tstd::cout << def;\n\t\t\tint id1 = rs1_addr;\n\t\t\tint id2 = rs2_addr;\n\t\t\tint raw_id1 = rs1_raw ? id1 : -1;\n\t\t\tint raw_id2 = rs2_raw ? id2 : -1;\n\t\t\tfor(int i = 0; i < REG_NUM; ) {\n\t\t\t\tfor (int j = 0; j < 8; j++) {\n\t\t\t\t\tint r = regfile[i].to_int();\n\t\t\t\t\tif (sentinel[i] != SENTINEL_INIT && (raw_id1 == i || raw_id2 == i) && !freeze) {\n\t\t\t\t\t\tstd::cout << \" \" << green << std::right << std::setfill(' ') << std::setw(2) << i << \": 0x\" << std::hex << std::left << std::setfill(' ') << std::setw(10) << r << std::dec << def;\n\t\t\t\t\t} else if (sentinel[i] != SENTINEL_INIT && (raw_id1 == i || raw_id2 == i)) {\n\t\t\t\t\t\tstd::cout << \" \" << red << std::right << std::setfill(' ') << std::setw(2) << i << \": 0x\" << std::hex << std::left << std::setfill(' ') << std::setw(10) << r << std::dec << def;\n\t\t\t\t\t} else if (sentinel[i] != SENTINEL_INIT) {\n\t\t\t\t\t\tstd::cout << \" \" << yellow << std::right << std::setfill(' ') << std::setw(2) << i << \": 0x\" << std::hex << std::left << std::setfill(' ') << std::setw(10) << r << std::dec << def;\n\t\t\t\t\t} else {\n\t\t\t\t\t\tstd::cout << \" \" << std::right << std::setfill(' ') << std::setw(2) << i << \": 0x\" << std::hex << std::left << std::setfill(' ') << std::setw(10) << r << std::dec;\n\t\t\t\t\t}\n\t\t\t\t\ti++;\n\t\t\t\t\tif (i == REG_NUM)\n\t\t\t\t\t\tbreak;\n\t\t\t\t}\n\t\t\t\tstd::cout << endl;\n\t\t\t\tif (i == REG_NUM)\n\t\t\t\t\tbreak;\n\t\t\t\tstd::cout << \"                                                             \";\n\t\t\t}\n#endif\n\n#endif\n\n\t\t// *** Transform instruction into nop when freeze is active\n\t\tif (freeze) {\n\t\t\t// Bubble.\n\t\t\toutput.regwrite     = \"0\";\n\t\t\toutput.ld           = NO_LOAD;\n\t\t\toutput.st           = NO_STORE;\n\t\t}\n\t\tdout.put(output);\n\n\t} // *** ENDOF while(true)\n}   // *** ENDOF sc_cthread\n\n\n// --- Utility functions.\n\n// Sign extend UJ insn.\nsc_bv<PC_LEN> fedec::sign_extend_jump(sc_bv<21> imm)\n{\n\tif (imm.range(20, 20) == \"1\")\n\t\treturn (\"11111111111\", imm);\n\telse\n\t\treturn (\"00000000000\", imm);\n}\n\n// Sign extend branch insn.\nsc_bv<PC_LEN> fedec::sign_extend_branch(sc_bv<13> imm)\n{\n\tif (imm.range(12, 12) == \"1\")\n\t\treturn (\"1111111111111111111\", imm);\n\telse\n\t\treturn (\"0000000000000000000\", imm);\n}\n\n// --- End of utility functions.\n", "groundtruth": "\t\tdo {wait();} while(!fetch_en);\n", "crossfile_context": "", "source_line": 53, "groundtruth_line_count": 1, "why": "design path, has related tests", "related_tests": ["hl5/soft/test.c", "hl5/tb/colormod.hpp", "hl5/tb/sc_main.cpp", "hl5/tb/system.cpp", "hl5/tb/system.hpp", "hl5/tb/tb.cpp", "hl5/tb/tb.hpp"], "local_folder": "fedec", "local_file": "fedec/fedec.cpp", "local_original_file": "fedec/fedec_original.cpp", "selection_score": 51}
{"task_id": "hl5", "path": "hl5/src/memwb.cpp", "left_context": "/* Copyright 2017 Columbia University, SLD Group */\n\n//\n// memory.cpp - Robert Margelli\n// Implementation of the memwb stage ie combined memory and writeback stages.\n//\n\n#include \"memwb.hpp\"\n\nvoid memwb::memwb_th(void)\n{\nMEMWB_RST:\n\t{\n\t\tPROTO_MEMWB_RST;\n\t\tdin.reset_get();\n\t\tdout.reset_put();\n\n\t\t// Write dummy data to decode feedback.\n\t\toutput.regfile_address = \"00000\";\n\t\toutput.regfile_data    = (sc_bv<XLEN>)0;\n\t\toutput.regwrite        = \"0\";\n\t\toutput.tag             = 0;\n\n\t\tdo {wait();} while(!fetch_en); // Synchronize with fetch stage at startup.\n\n\t\tdout.put(output);\n\t\twait();\n\t\tdout.put(output);\n\t}\n\nMEMWB_BODY:\n\twhile(true) {\n\t\tPROTO_MEMWB_BODY;\n\t\tBREAK_DMEM_DEP;\n\n\t\t// Get\n\t\tinput = din.get();\n\n\t\t// Compute\n\t\t// *** Memory access.\n\n\t\t// WARNING: only supporting aligned memory accesses\n\n\t\t// Preprocess address\n\t\tunsigned int aligned_address = input.alu_res.to_uint();\n\t\tunsigned char byte_index = (unsigned char) ((aligned_address & 0x3) << 3);\n\t\tunsigned char halfword_index = (unsigned char) ((aligned_address & 0x2) << 3);\n\n\t\taligned_address = aligned_address >> 2;\n\t\tsc_uint<BYTE> db;\n", "right_context": "\t\tsc_uint<XLEN> dw;\n\n\t\twait();\n\n#ifndef STRATUS_HLS\n\t\tif (sc_uint<3>(input.ld) != NO_LOAD || sc_uint<2>(input.st) != NO_STORE) {\n#ifndef VERBOSE\n\t\t\tif (input.mem_datain.to_uint() == 0x11111111 ||\n\t\t\t    input.mem_datain.to_uint() == 0x22222222 ||\n\t\t\t    input.mem_datain.to_uint() == 0x11223344 ||\n\t\t\t    input.mem_datain.to_uint() == 0x88776655 ||\n\t\t\t    input.mem_datain.to_uint() == 0x12345678 ||\n\t\t\t    input.mem_datain.to_uint() == 0x87654321) {\n#endif\n\t\t\t\tstd::stringstream stm;\n\t\t\t\tstm << hex << \"D$ access here2 -> 0x\" << aligned_address << \". Value: \" << input.mem_datain.to_uint() << std::endl;\n\t\t\t\tSC_REPORT_INFO(sc_object::name(), stm.str().c_str());\n#ifndef VERBOSE\n\t\t\t}\n#endif\n\t\t\tsc_assert(aligned_address < DCACHE_SIZE);\n\t\t}\n#endif\n\n\t\tif (sc_uint<3>(input.ld) != NO_LOAD) {    // a load is requested\n\t\t\tswitch(sc_uint<3>(input.ld)) {         // LOAD\n\t\t\tcase LB_LOAD:\n\t\t\t\tdb = dmem[aligned_address].range(byte_index + BYTE - 1, byte_index);\n\t\t\t\tmem_dout = ext_sign_byte(db);\n\t\t\t\tbreak;\n\t\t\tcase LH_LOAD:\n\t\t\t\tdh = dmem[aligned_address].range(halfword_index + 2 * BYTE - 1, halfword_index);\n\t\t\t\tmem_dout = ext_sign_halfword(dh);\n\t\t\t\tbreak;\n\t\t\tcase LW_LOAD:\n\t\t\t\tdw = dmem[aligned_address];\n\t\t\t\tmem_dout = dw;\n\t\t\t\tbreak;\n\t\t\tcase LBU_LOAD:\n\t\t\t\tdb = dmem[aligned_address].range(byte_index + BYTE - 1, byte_index);\n\t\t\t\tmem_dout = ext_unsign_byte(db);\n\t\t\t\tbreak;\n\t\t\tcase LHU_LOAD:\n\t\t\t\tdh = dmem[aligned_address].range(halfword_index + 2 * BYTE - 1, halfword_index);\n\t\t\t\tmem_dout = ext_unsign_halfword(dh);\n\t\t\t\tbreak;\n\t\t\tdefault:\n\t\t\t\tbreak;  // NO_LOAD\n\t\t\t}\n\t\t}\n\t\telse if (sc_uint<2>(input.st) != NO_STORE) {  // a store is requested\n\t\t\tswitch (sc_uint<2>(input.st)) {         // STORE\n\t\t\tcase SB_STORE:  // store 8 bits of rs2\n\t\t\t\tdb = input.mem_datain.range(BYTE - 1, 0).to_uint();\n\t\t\t\tdmem[aligned_address].range(byte_index + BYTE -1, byte_index) = db;\n\t\t\t\tbreak;\n\t\t\tcase SH_STORE:  // store 16 bits of rs2\n\t\t\t\tdh = input.mem_datain.range(2 * BYTE - 1, 0).to_uint();\n\t\t\t\tdmem[aligned_address].range(halfword_index + 2 * BYTE - 1, halfword_index) = dh;\n\t\t\t\tbreak;\n\t\t\tcase SW_STORE:  // store rs2\n\t\t\t\tdw = input.mem_datain.to_uint();\n\t\t\t\tdmem[aligned_address] = dw;\n\t\t\t\tbreak;\n\t\t\tdefault:\n\t\t\t\tbreak;  // NO_STORE\n\t\t\t}\n\t\t}\n\t\t// *** END of memory access.\n\n\t\t/* Writeback */\n\t\toutput.regwrite         = input.regwrite;\n\t\toutput.regfile_address  = input.dest_reg;\n\t\toutput.regfile_data     = (input.memtoreg == \"1\")? mem_dout : input.alu_res;\n\t\toutput.tag              = input.tag;\n\n\t\t// Put\n\t\tdout.put(output);\n\t}\n}\n\n\n/* Support functions */\n\n// Sign extend byte read from memory. For LB\nsc_bv<XLEN> memwb::ext_sign_byte(sc_bv<BYTE> read_data)\n{\n\tif (read_data.range(7,7) == \"1\")\n\t\treturn (sc_bv<BYTE*3>(\"111111111111111111111111\"), read_data);\n\telse\n\t\treturn (sc_bv<BYTE*3>(\"000000000000000000000000\"), read_data);\n}\n\n// Zero extend byte read from memory. For LBU\nsc_bv<XLEN> memwb::ext_unsign_byte(sc_bv<BYTE> read_data)\n{\n        return (\"000000000000000000000000\", read_data);\n}\n\n// Sign extend half-word read from memory. For LH\nsc_bv<XLEN> memwb::ext_sign_halfword(sc_bv<BYTE*2> read_data)\n{\n\tif (read_data.range(15,15) == \"1\")\n\t\treturn (sc_bv<BYTE*2>(\"1111111111111111\"), read_data);\n\telse\n\t\treturn (sc_bv<BYTE*2>(\"0000000000000000\"), read_data);\n}\n\n// Zero extend half-word read from memory. For LHU\nsc_bv<XLEN> memwb::ext_unsign_halfword(sc_bv<BYTE*2> read_data)\n{\n        return (\"0000000000000000\", read_data);\n}\n", "groundtruth": "\t\tsc_uint<2 * BYTE> dh;\n", "crossfile_context": "", "source_line": 51, "groundtruth_line_count": 1, "why": "design path, has related tests", "related_tests": ["hl5/soft/test.c", "hl5/tb/colormod.hpp", "hl5/tb/sc_main.cpp", "hl5/tb/system.cpp", "hl5/tb/system.hpp", "hl5/tb/tb.cpp", "hl5/tb/tb.hpp"], "local_folder": "memwb", "local_file": "memwb/memwb.cpp", "local_original_file": "memwb/memwb_original.cpp", "selection_score": 51}
{"task_id": "GlobalCorrelator_HLS", "path": "GlobalCorrelator_HLS/regionizer/regionizer_ref.cpp", "left_context": "#include \"firmware/regionizer.h\"\n#include \"../utils/test_utils.h\"\n\ntemplate<typename T, int N_OBJ> \nvoid push_in(const T & in, T out[N_OBJ]) {\n    for (int i = N_OBJ-1; i >= 0; --i) {\n        if (out[i].hwPt < in.hwPt) {\n            if (i == 0 || out[i-1].hwPt >= in.hwPt) {\n                out[i] = in;\n            } else {\n                out[i] = out[i-1];\n            }            \n        } \n    }\n}\n\ntemplate<typename T, int N_OBJ_PER_SECTOR_PER_ETA> \nvoid push_in_sector_ref(const T & in, T out[N_OBJ_PER_SECTOR_PER_ETA], etaphi_t etaMin, etaphi_t etaMax, etaphi_t etaShift) {\n    if (etaMin <= in.hwEta && in.hwEta <= etaMax) {\n        for (int i = N_OBJ_PER_SECTOR_PER_ETA-1; i >= 0; --i) {\n            if (out[i].hwPt < in.hwPt) {\n                if (i == 0 || out[i-1].hwPt >= in.hwPt) {\n                    out[i] = in;\n                    out[i].hwEta += etaShift;\n                } else {\n                    out[i] = out[i-1];\n                }            \n            } \n        }\n    }\n}\n\ntemplate<typename T, int N_OBJ_PER_SECTOR_PER_ETA, int N_OBJ_PER_REGION> \nvoid merge_sectors_ref(T list1[N_OBJ_PER_SECTOR_PER_ETA], etaphi_t phiShift1, T list2[N_OBJ_PER_SECTOR_PER_ETA], etaphi_t phiShift2, T list3[N_OBJ_PER_SECTOR_PER_ETA], etaphi_t phiShift3, T out[N_OBJ_PER_REGION]) {\n    unsigned int i1 = 0, i2 = 0, i3 = 0;\n    for (unsigned int i = 0; i < N_OBJ_PER_REGION; ++i) {\n        clear(out[i]);\n    }\n    for (unsigned int i = 0; i < N_OBJ_PER_REGION; ++i) {\n        pt_t pt1 = (i1 < N_OBJ_PER_SECTOR_PER_ETA ? list1[i1].hwPt : pt_t(0));\n        pt_t pt2 = (i2 < N_OBJ_PER_SECTOR_PER_ETA ? list2[i2].hwPt : pt_t(0));\n        pt_t pt3 = (i3 < N_OBJ_PER_SECTOR_PER_ETA ? list3[i3].hwPt : pt_t(0));\n        if (pt1 >= pt2 && pt1 >= pt3) {\n            if (pt1 == 0) break; // if i'm picking a null, it means I'm out of objects\n            out[i] = list1[i1]; \n            out[i].hwPhi += phiShift1;\n            i1++;  \n        } else if (pt1 < pt2 && pt2 >= pt3)  {\n            assert(i2 < N_OBJ_PER_SECTOR_PER_ETA);\n            out[i] = list2[i2]; \n            out[i].hwPhi += phiShift2;\n            i2++;  \n        } else {\n            assert(i3 < N_OBJ_PER_SECTOR_PER_ETA);\n            out[i] = list3[i3]; \n            out[i].hwPhi += phiShift3;\n            i3++;  \n        }\n    }\n}\n\ntemplate<typename T, int N_OBJ_PER_SECTOR, int N_OBJ_PER_SECTOR_PER_ETA, int N_OBJ_PER_REGION, int N_FIBERS_PER_SECTOR=1> \nvoid regionize_ref(hls::stream<T> instream[N_FIBERS_PER_SECTOR*N_IN_SECTORS], T regions[N_OUT_REGIONS][N_OBJ_PER_REGION]) {\n\n    // define and clear work area for deserializers \n    static T obj_sector_eta[N_IN_SECTORS][N_OUT_REGIONS_ETA][N_OBJ_PER_SECTOR_PER_ETA];\n    for (unsigned int is = 0; is < N_IN_SECTORS; ++is) {\n        for (unsigned int ie = 0; ie < N_OUT_REGIONS_ETA; ++ie) {\n            for (unsigned int io = 0; io < N_OBJ_PER_SECTOR_PER_ETA; ++io) {\n                clear(obj_sector_eta[is][ie][io]);\n            }\n        }\n    }\n    // steam the data in\n    for (unsigned int io = 0; io < N_OBJ_PER_SECTOR/N_FIBERS_PER_SECTOR; ++io) {\n        for (unsigned int is = 0; is < N_IN_SECTORS; ++is) {\n            for (unsigned int f = 0; f < N_FIBERS_PER_SECTOR; ++f) {\n                T in = instream[N_FIBERS_PER_SECTOR*is+f].read();\n                //if (in.hwPt > 0) printf(\"Object %d in sector %d, ieta %+3d (eta %+.3f) bounds [%+3d,%+3d]; [%+3d,%+3d]; [%+3d,%+3d]\\n\", io, is, int(in.hwEta), in.hwEta*0.25/_ETA_025, ETA_MIN[0], ETA_MAX[0], ETA_MIN[1], ETA_MAX[1], ETA_MIN[2], ETA_MAX[2]);\n                for (unsigned int ie = 0; ie < N_OUT_REGIONS_ETA; ++ie) {\n                    push_in_sector_ref<T,N_OBJ_PER_SECTOR_PER_ETA>(in, obj_sector_eta[is][ie], ETA_MIN[ie], ETA_MAX[ie], ETA_SHIFT[ie]);\n                    //if (in.hwPt > 0) printf(\"  