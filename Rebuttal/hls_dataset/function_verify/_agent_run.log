+def blocker_body(folder: str, reason: str, row: dict) -> str:
+    return textwrap.dedent(
+        f"""
+        # Blocker
+
+        - Folder: `{folder}`
+        - Local source: `{row['local_file']}`
+        - Local original: `{row['local_original_file']}`
+        - Inferred DUT entry: `{infer_entry(row['local_folder'])}`
+        - Reason: {reason}
+
