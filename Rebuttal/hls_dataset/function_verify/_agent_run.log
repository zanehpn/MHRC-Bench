{"task_id": "hls-spmv", "path": "hls-spmv/src/spmv_naive_stream.cpp", "left_context": "#include \"spmv.h\"\n#include <hls_stream.h>\n\nvoid spmv_kernel(int rows_length[NUM_ROWS], int cols[NNZ], DTYPE values[NNZ], DTYPE y[SIZE], DTYPE x[SIZE])\n{\n#pragma HLS DATAFLOW\n\n\thls::stream<int>   rows_fifo;\n\thls::stream<DTYPE> values_fifo;\n\thls::stream<int>   cols_fifo;\n\thls::stream<DTYPE> results_fifo;\n\n\n\tfor (int i = 0; i < NUM_ROWS; i++) {\n#pragma HLS PIPELINE\n\t\trows_fifo << rows_length[i];\n\t}\n\n\tfor (int i = 0; i < NNZ; i++) {\n#pragma HLS PIPELINE\n\t\tvalues_fifo << values[i];\n\t\tcols_fifo   << cols[i];\n\t}\n\n", "right_context": "\tDTYPE sum = 0;\n\tDTYPE value;\n\tint col;\n\n\tfor (int i = 0; i < NNZ; i++) {\n#pragma HLS PIPELINE\n\t\tif (col_left == 0) {\n\t\t\tcol_left = rows_fifo.read();\n\t\t\tsum = 0;\n\t\t}\n\t\tvalue = values_fifo.read();\n\t\tcol   = cols_fifo.read();\n\t\tsum  += value * x[col];\n\t\tcol_left--;\n\t\tif (col_left == 0) {\n\t\t\tresults_fifo << sum;\n\t\t}\n\t}\n\n\tfor (int i = 0; i < NUM_ROWS; i++) {\n#pragma HLS PIPELINE\n\t\ty[i] = results_fifo.read();\n\t}\n}\n\n\nvoid spmv(int rowPtr[NUM_ROWS + 1], int cols[NNZ], DTYPE values[NNZ], DTYPE y[SIZE], DTYPE x[SIZE])\n{\n\t// rowPtr to rows_length\n\tint rows_length[NUM_ROWS] = {0};\n\tfor (int i = 1; i < NUM_ROWS + 1; i++) {\n#pragma HLS PIPELINE\n\t\trows_length[i - 1] = rowPtr[i] - rowPtr[i - 1];\n\t}\n\n\tspmv_kernel(rows_length, cols, values, y, x);\n}\n", "groundtruth": "\tint col_left = 0;\n", "crossfile_context": "", "source_line": 25, "groundtruth_line_count": 1, "why": "design path, hls kernel style code, has related tests", "related_tests": ["hls-spmv/tb/spmv_test.cpp", "hls-spmv/tb/testcase.py"], "local_folder": "spmv_naive_stream", "local_file": "spmv_naive_stream/spmv_naive_stream.cpp", "local_original_file": "spmv_naive_stream/spmv_naive_stream_original.cpp", "selection_score": 58}
{"task_id": "hls-spmv", "path": "hls-spmv/src/spmv_partial_unrolling.cpp", "left_context": "#include \"spmv.h\"\n\nconst static int S = 9;\n\nvoid spmv(int rowPtr[NUM_ROWS+1], int columnIndex[NNZ],\n\t\tDTYPE values[NNZ], DTYPE y[SIZE], DTYPE x[SIZE])\n{\nL1: for (int i = 0; i < NUM_ROWS; i++) {\n\t\tDTYPE y0 = 0;\n\tL2_1: for (int k = rowPtr[i]; k < rowPtr[i+1]; k+=S) {\n#pragma HLS pipeline II=S\n", "right_context": "\t\t\tL2_2: for (int j = 1; j < S; j++) {\n\t\t\t\tif (k + j < rowPtr[i + 1]) {\n\t\t\t\t\tyt += values[k+j] * x[columnIndex[k+j]];\n\t\t\t\t}\n\t\t\t}\n\t\t\ty0 += yt;\n\t\t}\n\t\ty[i] = y0;\n\t}\n}\n", "groundtruth": "\t\t\tDTYPE yt = values[k] * x[columnIndex[k]];\n", "crossfile_context": "", "source_line": 12, "groundtruth_line_count": 1, "why": "design path, hls kernel style code, has related tests", "related_tests": ["hls-spmv/tb/spmv_test.cpp", "hls-spmv/tb/testcase.py"], "local_folder": "spmv_partial_unrolling", "local_file": "spmv_partial_unrolling/spmv_partial_unrolling.cpp", "local_original_file": "spmv_partial_unrolling/spmv_partial_unrolling_original.cpp", "selection_score": 58}
{"task_id": "HLSBitNet", "path": "HLSBitNet/forward_llama_app_kernels/src/forward-min-area.cpp", "left_context": "#include \"forward.h\"\n#include \"config.h\"\n#include <cstring>\n\n// TODO: include HLS math package\n#include \"hls_math.h\"\n\n// neural net blocks; the dynamics of the Transformer\ntemplate <int S>\n\n// o = output, x = input, weight = array of gain params\nvoid rmsnorm(float o[S], float x[S], float weight[S])\n{\n#pragma HLS INLINE off\n#pragma HLS ALLOCATION instances=fmul limit=1 operation\n#pragma HLS ALLOCATION instances=fadd limit=1 operation\n#pragma HLS ALLOCATION instances=fdiv limit=1 operation\n#pragma HLS ALLOCATION instances=fsqrt limit=1 operation\n\n  // calculate sum of squares\n  float ss = 0.0f;\nsum_of_squares:\n  for (int j = 0; j < S; j++)\n  {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor=1\n    float x_j = x[j];\n    ss += x_j * x_j;\n  }\n  ss /= S;\n  ss += 1e-5f;\n  ss = 1.0f / hls::sqrtf(ss);\n// normalize and scale\nnorm_and_scale:\n  for (int j = 0; j < S; j++)\n  {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor=1\n    // o[j] = weight[j] * (ss * x[j]);\n    float x_j = x[j];\n    float weight_j = weight[j];\n    o[j] = weight_j * (ss * x_j);\n  }\n}\n\ntemplate <int MAXSIZE>\nvoid softmax(float *x, int size)\n{\n#pragma HLS INLINE off\n#pragma HLS ALLOCATION instances=fcmp limit=1 operation\n#pragma HLS ALLOCATION instances=fadd limit=1 operation\n#pragma HLS ALLOCATION instances=fmul limit=1 operation\n#pragma HLS ALLOCATION instances=fdiv limit=1 operation\n#pragma HLS ALLOCATION instances=fsub limit=1 operation\n\n  // find max value (for numerical stability)\n  float buffer[MAXSIZE];\n#pragma HLS ARRAY_RESHAPE variable=buffer type=complete dim=0\n  float max_val = x[0];\nmax:\n  for (int i = 1; i < size; i++)\n  {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor=1\n    float x_i = x[i];\n    if (x_i > max_val)\n    {\n      max_val = x_i;\n    }\n  }\n  // exp and sum\n\nexp:\n  for (int i = 0; i < size; i++)\n  {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor=1\n    float x_i = hls::expf(x[i] - max_val);\n    buffer[i] = x_i;\n  }\n  float sum = 0.0f;\nsum:\n  for (int i = 0; i < size; i++)\n  {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor=1\n    sum += buffer[i];\n  }\n  // normalize\n  const float inv_sum = 1.0 / sum;\nnorm:\n  for (int i = 0; i < size; i++)\n  {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor=1\n    x[i] = buffer[i] * inv_sum;\n  }\n}\n\ntemplate <int N, int D>\nvoid matmul(float *xout, int8_t *xq, float *xs, int8_t *wq, float *ws)\n{\n#pragma HLS INLINE off\n#pragma HLS ALLOCATION instances=mul limit=1 operation\n#pragma HLS ALLOCATION instances=add limit=1 operation\n#pragma HLS ALLOCATION instances=fadd limit=1 operation\n#pragma HLS ALLOCATION instances=fmul limit=1 operation\n\n  // W (d,n) @ x (n,) -> xout (d,)\n  // by far the most amount of time is spent inside this little function\n  // inputs to this function are both quantized\n\n  // wq - quantized weight matrix\n  // ws - scaling factor for each row of wq\n  // xq - quantized input vector\n  // xs - scaling factor for xq\n  // xout - output vector\n\n  static int8_t x_buffer[N];\n#pragma HLS ARRAY_RESHAPE variable=x_buffer type=block factor=2 dim=1\n  static float xs_buffer[N / GS];\n#pragma HLS ARRAY_RESHAPE variable=xs_buffer type=block factor=2 dim=1\n\nx_buff:\n  for (int i = 0; i < N; i++)\n  {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor=1\n    x_buffer[i] = xq[i];\n  }\nxs_buff:\n  for (int j = 0; j <= N - GS; j += GS)\n  {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor=1\n    xs_buffer[j / GS] = xs[j / GS];\n  }\n\n  // Iterate over each row of the weight matrix\n  for (int i = 0; i < D; i++)\n  {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor=1\n    float val = 0.0f;\n    const int w_row_offset = i * N;\n    const int ws_row_offset = i * (N / GS);\n\n    // do the matmul in groups of GS\n    for (int j = 0; j <= N - GS; j += GS)\n    {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor=1\n      int32_t ival = 0;\n      for (int k = 0; k < GS; k++)\n      {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor=1\n        int32_t buffer1 = (int32_t)x_buffer[j + k];\n        // Read directly from the weight matrix in global memory\n        int32_t buffer2 = (int32_t)wq[w_row_offset + j + k];\n        if (buffer1 == -1) ival -= buffer2;\n        if (buffer1 == 1) ival += buffer2;\n      }\n      // Read directly from the scaling factors in global memory\n      val += ((float)ival) * ws[ws_row_offset + j / GS] * xs_buffer[j / GS];\n    }\n    xout[i] = val;\n  }\n}\n\nextern \"C\" void forward(Transformer<dim, hidden_dim, n_layers, n_heads, n_kv_heads, vocab_size, seq_len, GS> *transformer, int token, int pos, float key_cache[n_layers * seq_len * ((dim * n_kv_heads) / n_heads)], float value_cache[n_layers * seq_len * ((dim * n_kv_heads) / n_heads)], float *out)\n{\n#pragma HLS INTERFACE m_axi port = transformer offset = slave bundle = gmem0\n#pragma HLS INTERFACE m_axi port = out offset = slave bundle = gmem1\n\n// Area optimization directives\n#pragma HLS ALLOCATION instances=fadd limit=2 operation\n#pragma HLS ALLOCATION instances=fmul limit=2 operation\n#pragma HLS ALLOCATION instances=fsub limit=1 operation\n#pragma HLS ALLOCATION instances=fdiv limit=1 operation\n#pragma HLS ALLOCATION instances=fcmp limit=1 operation\n#pragma HLS ALLOCATION instances=fsqrt limit=1 operation\n#pragma HLS ALLOCATION instances=add limit=2 operation\n#pragma HLS ALLOCATION instances=mul limit=2 operation\n#pragma HLS ALLOCATION instances=rmsnorm limit=1 function\n#pragma HLS ALLOCATION instances=matmul limit=1 function\n#pragma HLS ALLOCATION instances=softmax limit=1 function\n\n  // a few convenience variables\n  auto w = &transformer->weights;\n  static float x[config.dim];                                        // activation at current time stamp (dim,)\n#pragma HLS ARRAY_RESHAPE variable=x type=block factor=4 dim=1\n  static float xb[config.dim];                                       // same, but inside a residual branch (dim,)\n#pragma HLS ARRAY_RESHAPE variable=xb type=block factor=4 dim=1\n  static float xb2[config.dim];                                      // an additional buffer just for convenience (dim,)\n#pragma HLS ARRAY_RESHAPE variable=xb2 type=block factor=4 dim=1\n  static float hb[config.hidden_dim];                                // buffer for hidden dimension in the ffn (hidden_dim,)\n#pragma HLS ARRAY_RESHAPE variable=hb type=block factor=4 dim=1\n  static float hb2[config.hidden_dim];                               // buffer for hidden dimension in the ffn (hidden_dim,)\n#pragma HLS ARRAY_RESHAPE variable=hb2 type=block factor=4 dim=1\n  static QuantizedTensor<config.dim> xq;                             // quantized x (dim,)\n  static QuantizedTensor<config.hidden_dim> hq;                      // quantized hb (hidden_dim,)\n  static float q[config.dim];                                        // query (dim,)\n#pragma HLS ARRAY_RESHAPE variable=q type=block factor=4 dim=1\n  static float k[(config.dim * config.n_kv_heads) / config.n_heads]; // key (dim,)\n#pragma HLS ARRAY_RESHAPE variable=k type=block factor=4 dim=1\n  static float v[(config.dim * config.n_kv_heads) / config.n_heads]; // value (dim,)\n#pragma HLS ARRAY_RESHAPE variable=v type=block factor=4 dim=1\n  static float att[config.n_heads * config.seq_len];                 // buffer for scores/attention values (n_heads, seq_len)\n#pragma HLS ARRAY_RESHAPE variable=att type=block factor=4 dim=1\n\n  constexpr int kv_dim = (config.dim * config.n_kv_heads) / config.n_heads;\n  constexpr int kv_mul = config.n_heads / config.n_kv_heads; // integer multiplier of the kv sharing in multiquery\n  constexpr int head_size = dim / config.n_heads;\n\n  // copy the token embedding into x\n  std::memcpy(x, w->token_embedding_table + token * dim, dim * sizeof(float));\n\n// forward all the layers\nmain_forward_loop:\n  for (int l = 0; l < config.n_layers; l++)\n  {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor=1\n    // attention rmsnorm\n    rmsnorm<dim>(xb, x, w->rms_att_weight + l * dim);\n\n    // qkv matmuls for this position\n    quantize(&xq, xb, GS);\n    matmul<dim, dim>(q, xq.q, xq.s, (w->wq + l)->q, (w->wq + l)->s);\n    matmul<dim, kv_dim>(k, xq.q, xq.s, (w->wk + l)->q, (w->wk + l)->s);\n    matmul<dim, kv_dim>(v, xq.q, xq.s, (w->wv + l)->q, (w->wv + l)->s);\n\n  // RoPE relative positional encoding: complex-valued rotate q and k in each head\n  // Process the portion where both query and key vectors are involved (i < kv_dim)\n  rotation1:\n    // Rotation for both query and key vectors (i < kv_dim)\n    for (int i = 0; i < kv_dim; i += 2)\n    {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor=1\n      int head_dim = i % head_size;\n      float freq = 1.0f / hls::powf(10000.0f, head_dim / (float)head_size);\n      float val = pos * freq;\n      float fcr, fci;\n      hls::sincosf(val, &fci, &fcr);\n\n      // Rotate the query vector\n      float v0_q = q[i];\n      float v1_q = q[i + 1];\n      q[i] = v0_q * fcr - v1_q * fci;\n      q[i + 1] = v0_q * fci + v1_q * fcr;\n\n      // Rotate the key vector\n      float v0_k = k[i];\n      float v1_k = k[i + 1];\n      k[i] = v0_k * fcr - v1_k * fci;\n      k[i + 1] = v0_k * fci + v1_k * fcr;\n    }\n  rotation2:\n    // Rotation for only the query vector (i >= kv_dim)\n    for (int i = kv_dim; i < dim; i += 2)\n    {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor=1\n      int head_dim = i % head_size;\n      float freq = 1.0f / hls::powf(10000.0f, head_dim / (float)head_size);\n      float val = pos * freq;\n      float fcr, fci;\n      hls::sincosf(val, &fci, &fcr);\n\n      // Rotate only the query vector\n      float v0 = q[i];\n      float v1 = q[i + 1];\n      q[i] = v0 * fcr - v1 * fci;\n      q[i + 1] = v0 * fci + v1 * fcr;\n    }\n    // save key,value at this time step (pos) to our kv cache\n    int loff = l * config.seq_len * kv_dim; // kv cache layer offset for convenience\n    float *key_cache_row = key_cache + loff + pos * kv_dim;\n", "right_context": "\n    std::memcpy(key_cache_row, k, kv_dim * sizeof(*key_cache_row));\n    std::memcpy(value_cache_row, v, kv_dim * sizeof(*value_cache_row));\n\n    // multihead attention. iterate over all heads\n    int h;\n\n  multihead_attention:\n    for (h = 0; h < n_heads; h++)\n    {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor=1\n      const int q_offset = h * head_size;\n      const int att_offset = h * seq_len;\n    iterate:\n      for (int t = 0; t <= pos; t++)\n      {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor=1\n        const int key_offset = loff + t * kv_dim + (h / kv_mul) * head_size;\n        float score = 0.0f;\n        for (int i = 0; i < head_size; i++)\n        {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor=1\n          score += q[i + q_offset] * key_cache[i + key_offset];\n        }\n        score /= hls::sqrtf(head_size);\n        att[t + att_offset] = score;\n      }\n\n      softmax<257>(att + att_offset, pos + 1);\n\n      const int xb_offset = h * head_size;\n      memset(xb + xb_offset, 0, head_size * sizeof(float));\n    acc:\n      for (int t = 0; t <= pos; t++)\n      {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor=1\n        const int v_offset = loff + t * kv_dim + (h / kv_mul) * head_size;\n        float a = att[t + att_offset];\n      acc_inner:\n        for (int i = 0; i < head_size; i++)\n        {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor=1\n          xb[i + xb_offset] += a * value_cache[i + v_offset];\n        }\n      }\n    }\n\n    // final matmul to get the output of the attention\n    quantize(&xq, xb, GS);\n    matmul<dim, dim>(xb2, xq.q, xq.s, (w->wo + l)->q, (w->wo + l)->s);\n\n  residual:\n    for (int i = 0; i < dim; i++)\n    {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor=1\n      x[i] += xb2[i];\n    }\n\n    // ffn rmsnorm\n    rmsnorm<dim>(xb, x, w->rms_ffn_weight + l * dim);\n\n    // Now for FFN in PyTorch we have: self.w2(F.silu(self.w1(x)) * self.w3(x))\n    quantize(&xq, xb, GS);\n    matmul<dim, hidden_dim>(hb, xq.q, xq.s, (w->w1 + l)->q, (w->w1 + l)->s);\n    matmul<dim, hidden_dim>(hb2, xq.q, xq.s, (w->w3 + l)->q, (w->w3 + l)->s);\n    float hb_out[hidden_dim];\n#pragma HLS ARRAY_RESHAPE variable=hb_out type=block factor=4 dim=1\n  swi_glu:\n    for (int i = 0; i < hidden_dim; i++)\n    {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor=1\n      float val = hb[i];\n      // silu(x)=x*σ(x), where σ(x) is the logistic sigmoid\n      val *= (1.0f / (1.0f + hls::expf(-val)));\n      // elementwise multiply with w3(x)\n      val *= hb2[i];\n      hb_out[i] = val;\n    }\n    std::memcpy(hb, hb_out, hidden_dim * sizeof(float));\n\n    quantize(&hq, hb, GS);\n    matmul<hidden_dim, dim>(xb, hq.q, hq.s, (w->w2 + l)->q, (w->w2 + l)->s);\n\n  residual2:\n    for (int i = 0; i < dim; i++)\n    {\n#pragma HLS PIPELINE off\n#pragma HLS UNROLL factor=1\n      x[i] += xb[i];\n    }\n  }\n\n  // final rmsnorm\n  rmsnorm<dim>(x, x, w->rms_final_weight);\n\n  // classifier into logits\n  quantize(&xq, x, GS);\n  matmul<dim, vocab_size>(out, xq.q, xq.s, w->wcls->q, w->wcls->s);\n}\n", "groundtruth": "    float *value_cache_row = value_cache + loff + pos * kv_dim;\n", "crossfile_context": "", "source_line": 281, "groundtruth_line_count": 1, "why": "design path, hls kernel style code, has related tests", "related_tests": ["HLSBitNet/cpu_benchmarks/test.c"], "local_folder": "forward-min-area", "local_file": "forward-min-area/forward-min-area.cpp", "local_original_file": "forward-min-area/forward-min-area_original.cpp", "selection_score": 57}
